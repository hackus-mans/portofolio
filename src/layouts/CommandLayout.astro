---
import "../styles/command.css";
import "../styles/workspace.css";
import { site } from "../config";
import CommandSidebar from "../components/CommandSidebar.astro";
import CommandPreferences from "../components/CommandPreferences.astro";
const base=import.meta.env.BASE_URL.endsWith("/")?import.meta.env.BASE_URL:import.meta.env.BASE_URL+"/";
const title=site.name+" — NAKORE Cyber Intelligence";
const description="Portfolio interactif de Joseph NAKORE : explorateur de projets cybersécurité, SOC, pentest, recherche et automatisation. Les scénarios présentés sont des simulations pédagogiques.";
const canonical=new URL(Astro.url.pathname,"https://hackus-mans.github.io").toString();
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="color-scheme" content="dark"/>
<meta name="theme-color" content="#080c1b"/>
<meta name="description" content={description}/>
<meta name="robots" content="index,follow"/>
<meta property="og:type" content="website"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/>
<meta property="og:image" content={new URL(base+"joseph-soc-v2.webp","https://hackus-mans.github.io").toString()}/>
<link rel="canonical" href={canonical}/>
<link rel="icon" href={base+"favicon.svg"} type="image/svg+xml"/>
<title>{title}</title>
</head>
<body class="cc-body">
<a class="cc-skip" href="#main-content">Aller au contenu</a>
<div class="cc-app" id="cc-app">
  <CommandSidebar />
  <div class="cc-shell">
    <slot />
  </div>
</div>
<CommandPreferences />
</body>
</html>
