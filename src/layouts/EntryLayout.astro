---
import BaseLayout from "./BaseLayout.astro";
import { formatDate } from "../lib/content";
const {title,summary,publishedAt,updatedAt,tags=[],category,categoryHref,parentHref,parentLabel,meta=[],toc=[]}=Astro.props;
const rawBase=import.meta.env.BASE_URL;
const base=rawBase.endsWith("/")?rawBase:rawBase+"/";
---
<BaseLayout title={title+" — Joseph NAKORE"} description={summary} type="article">
  <main id="main-content">
    <article>
      <header class="article-head">
        <div class="container">
          <a class="back-link" href={base+categoryHref}>← Retour : {category}</a>
          {parentHref&&<a class="back-link" style="margin-left:20px" href={base+parentHref}>← {parentLabel||"Compétition"}</a>}
          <p class="label-dark">FIELD NOTES / {category.toUpperCase()}</p>
          <h1>{title}</h1>
          <p class="lead">{summary}</p>
          <div class="entry-meta">
            <div><span>Publication</span><strong>{formatDate(publishedAt)}</strong></div>
            {updatedAt&&<div><span>Mise à jour</span><strong>{formatDate(updatedAt)}</strong></div>}
            {meta.map(row=><div><span>{row.label}</span><strong>{row.value}</strong></div>)}
          </div>
          {tags.length>0&&<div class="entry-tags pill-list">{tags.map(tag=><span>{tag}</span>)}</div>}
        </div>
      </header>
      <div class="container article-layout">
        <div class="prose"><slot/></div>
        <aside class="article-sidebar">
          <p>INDEX / KNOWLEDGE</p>
          {toc.length>0&&<nav aria-label="Sommaire de l'article" class="entry-toc">
            <strong>Dans cet article</strong>
            {toc.map(heading=><a href={"#"+heading.slug} class:list={[{"entry-toc-sub":heading.depth===3}]}>{heading.text}</a>)}
          </nav>}
          <a href={base+categoryHref}>← Tous les {category.toLowerCase()}</a>
          {parentHref&&<a href={base+parentHref}>← {parentLabel||"Compétition CTF"}</a>}
          <a href={base+"projects/"}>Dossiers projets ↗</a>
          <a href={base+"roadmap/"}>Lumina Academy ↗</a>
        </aside>
      </div>
    </article>
  </main>
</BaseLayout>
