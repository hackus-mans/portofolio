---
import BaseLayout from "./BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { formatDate } from "../lib/content";

const {
  title,
  summary,
  publishedAt,
  updatedAt,
  tags = [],
  category,
  categoryHref,
  meta = []
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<BaseLayout title={title + " — Joseph NAKORE"} description={summary}>
  <Nav />
  <main>
    <article class="entry-page">
      <header class="entry-hero shell">
        <a class="back-link" href={base + categoryHref}>← {category}</a>
        <p class="overline">{category}</p>
        <h1>{title}</h1>
        <p class="entry-summary">{summary}</p>

        <div class="entry-meta">
          <div><span>Publié</span><strong>{formatDate(publishedAt)}</strong></div>
          {updatedAt && <div><span>Mis à jour</span><strong>{formatDate(updatedAt)}</strong></div>}
          {meta.map((item) => <div><span>{item.label}</span><strong>{item.value}</strong></div>)}
        </div>

        {tags.length > 0 && <div class="chips entry-tags">{tags.map((tag) => <span>{tag}</span>)}</div>}
      </header>

      <div class="entry-body shell prose">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
