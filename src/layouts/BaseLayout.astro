---
import "../styles/global.css";
import "../styles/command.css";
import "../styles/editorial.css";
import { site } from "../config";
import EditorialNav from "../components/EditorialNav.astro";
import EditorialFooter from "../components/EditorialFooter.astro";



const {
  title = site.name + " — Security Engineer in Progress",
  description = site.intro,
  image = "joseph-soc-v2.webp",
  type = "website"
} = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const origin = "https://hackus-mans.github.io";
const canonical = new URL(Astro.url.pathname, origin).toString();
const socialImage = new URL(base + image.replace(/^\//,""), origin).toString();
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: site.handle,
  description: site.intro,
  url: new URL(base, origin).toString(),
  sameAs: site.social.map((s) => s.href),
  address: { "@type": "PostalAddress", addressLocality: "Lomé", addressCountry: "TG" },
  affiliation: { "@type": "CollegeOrUniversity", name: site.education.school }
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e0c" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Joseph NAKORE — Cybersecurity Engineering" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="cc-body cc-inner-page studio ed-site">
    <a class="ed-skip" href="#main-content">Aller au contenu</a>
    <EditorialNav />
    <slot />
    <EditorialFooter />
  </body>
</html>
