---
import "../styles/global.css";
import "../styles/command.css";
import { site } from "../config";
import CommandSidebar from "../components/CommandSidebar.astro";
import CommandPalette from "../components/CommandPalette.astro";

const {
  title = site.name + " — Security Engineer in Progress",
  description = site.intro,
  image = "joseph-soc-v2.webp",
  type = "website"
} = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const origin = "https://hackus-mans.github.io";
const canonical = new URL(Astro.url.pathname, origin).toString();
const socialImage = new URL(base + image.replace(/^\//,""), origin).toString();
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: site.handle,
  description: site.intro,
  url: new URL(base, origin).toString(),
  sameAs: site.social.map((s) => s.href),
  address: { "@type": "PostalAddress", addressLocality: "Lomé", addressCountry: "TG" },
  affiliation: { "@type": "CollegeOrUniversity", name: site.education.school }
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e0c" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Joseph NAKORE — Cybersecurity Engineering" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="cc-body cc-inner-page studio">
    <a class="cc-skip" href="#main-content">Aller au contenu</a>
    <div class="cc-app">
      <CommandSidebar />
      <div class="cc-shell">
        <header class="cc-topbar cc-route-topbar">
          <div class="cc-crumb-left">
            <button type="button" class="cc-mobile-toggle" data-sidebar-toggle aria-label="Ouvrir le menu" aria-expanded="false"><span></span><span></span><span></span></button>
            <span class="cc-crumb-icon" aria-hidden="true">◎</span>
            <span class="cc-crumb"><a href={base}>NAKORE / FIELD ATLAS</a> <b>/</b> <strong>{title.split(" — ")[0]}</strong></span>
          </div>
          <div class="cc-topbar-right">
            <button type="button" class="cc-route-search" data-command-open>⌕ <span>Rechercher…</span><kbd>⌘ K</kbd></button>
            <span class="cc-top-status"><i></i> RESEARCH PORTFOLIO</span>
            <a class="cc-avatar" href={base+"about/"} aria-label="À propos de Joseph NAKORE">N<span></span></a>
          </div>
        </header>
        <CommandPalette />
        <slot />
        <footer class="cc-inner-footer"><span>NAKORE · CYBER INTELLIGENCE</span><span>OFFENSIVE / DEFENSIVE / AI ENGINEERING</span><a href={base}>RETOUR À L'ATLAS ↗</a></footer>
      </div>
    </div>
    <div class="cc-mobile-shade" data-sidebar-close></div>
    <script>
      const button=document.querySelector<HTMLButtonElement>("[data-sidebar-toggle]");
      const close=()=>{document.body.classList.remove("cc-sidebar-open");button?.setAttribute("aria-expanded","false")};
      button?.addEventListener("click",()=>{const open=document.body.classList.toggle("cc-sidebar-open");button.setAttribute("aria-expanded",String(open))});
      document.querySelectorAll("[data-sidebar-close]").forEach(el=>el.addEventListener("click",close));
      document.querySelectorAll(".cc-primary-nav a").forEach(el=>el.addEventListener("click",close));
    </script>
  </body>
</html>
