---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {site} from "../../config";
---
<BaseLayout title="Contact — Joseph NAKORE" description="Contacter Joseph NAKORE pour des questions de cybersécurité, des projets, stages ou collaborations.">
<main id="main-content" class="ed-container ed-subpage">
  <header class="ed-subpage-head"><span class="ed-overline">CONTACT / LET'S CONNECT</span><h1>Parlons cybersécurité<span class="ed-accent">.</span></h1>
  <p>Une question à propos d'un projet, une opportunité de stage, une collaboration ou un échange technique ? Retrouve-moi sur mes profils publics.</p></header>
  <div class="ed-contact-links">
    {site.social.map(link=><a href={link.href} target="_blank" rel="noopener noreferrer" class="ed-contact-link"><span>RÉSEAU / {link.label.toUpperCase()}</span><strong>{link.label}</strong><span>Ouvrir mon profil ↗</span></a>)}
  </div>
  <div class="ed-section"><div class="ed-contact-card"><div><span class="ed-overline">A PROPOS</span><h2>Un travail technique en évolution</h2><p>Mon portfolio documente mes expérimentations, leurs résultats et les limites que je rencontre au fil de ma formation.</p></div><a class="ed-btn ed-btn-outline" href={import.meta.env.BASE_URL+"about/"}>Lire mon parcours ↗</a></div></div>
</main>
</BaseLayout>
