---
import { getCollection, render } from "astro:content";
import EntryLayout from "../../layouts/EntryLayout.astro";
import { slugFromId } from "../../lib/content";

export async function getStaticPaths() {
  const entries = (await getCollection("labs")).filter((entry) => entry.data.status === "published");
  return entries.map((entry) => ({
    params: { slug: slugFromId(entry.id) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<EntryLayout
  title={entry.data.title}
  summary={entry.data.summary}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  category="Labs"
  categoryHref="labs/"
  meta={[
    { label: "Domaine", value: entry.data.domain },
    { label: "État", value: entry.data.state }
  ]}
>
  <Content />
</EntryLayout>
