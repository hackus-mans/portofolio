---
import {getCollection} from "astro:content";
import ArchiveCollection from "../../components/ArchiveCollection.astro";
import {formatDate,slugFromId} from "../../lib/content";
const rawBase=import.meta.env.BASE_URL;
const base=rawBase.endsWith("/")?rawBase:rawBase+"/";
const entries=(await getCollection("labs")).filter(e=>e.data.status==="published").sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime()).map(e=>({
 title:e.data.title,summary:e.data.summary,kind:e.data.domain,tags:e.data.tags,href:base+"labs/"+slugFromId(e.id)+"/",date:e.data.publishedAt,dateText:formatDate(e.data.publishedAt)
}));
---
<ArchiveCollection title="Labs" overline="FIELD NOTES / EXPERIMENTS" description="Des environnements contrôlés pour relier un comportement à un service, une permission, une vulnérabilité ou un événement de sécurité." entries={entries} kind="labs" />
