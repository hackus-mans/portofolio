---
const base=import.meta.env.BASE_URL.replace(/\/?$/,"/");
const target=base+"writeups/?type=lab";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="refresh" content={"0;url="+target}/>
    <meta name="robots" content="noindex"/>
    <link rel="canonical" href={target}/>
    <title>Redirection vers Write-ups</title>
  </head>
  <body><p>Les laboratoires font maintenant partie des <a href={target}>Write-ups</a>.</p></body>
</html>