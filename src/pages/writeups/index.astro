---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, slugFromId } from "../../lib/content";
import "../../styles/writeups.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const entries = (await getCollection("writeups"))
  .filter((entry) => entry.data.status === "published")
  .sort((a,b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map((entry) => ({
    title: entry.data.title,
    summary: entry.data.summary,
    platform: entry.data.platform || "Personnel",
    section: entry.data.section || "Autres",
    category: entry.data.category || "Général",
    difficulty: entry.data.difficulty || "",
    tags: entry.data.tags,
    date: entry.data.publishedAt,
    href: base + "writeups/" + slugFromId(entry.id) + "/"
  }));
const filters = [
  {key:"category", label:"Domaines", values:[...new Set(entries.map(e=>e.category))].sort((a,b)=>a.localeCompare(b,"fr"))},
  {key:"platform", label:"Plateformes", values:[...new Set(entries.map(e=>e.platform))].sort((a,b)=>a.localeCompare(b,"fr"))},
  {key:"section", label:"Types", values:[...new Set(entries.map(e=>e.section))].sort((a,b)=>a.localeCompare(b,"fr"))}
].filter(group=>group.values.length>0);
---
<BaseLayout title="Write-ups — Joseph NAKORE" description="Mes write-ups de cybersécurité, challenges et laboratoires : analyses, commandes, résultats et enseignements.">
  <main id="main-content" class="wu-page" data-wu-page>
    <div class="wu-container">
      <header class="wu-heading">
        <a class="wu-back" href={base}>← Retour au portfolio</a>
        <div class="wu-eyebrow"><span class="wu-pulse"></span> PRACTICE / FIELD NOTES</div>
        <div class="wu-heading-row">
          <div>
            <h1>Write-ups<span>.</span></h1>
            <p>Mes investigations en cybersécurité : de l'énumération aux enseignements défensifs, sur des environnements autorisés. Articles rédigés depuis mon espace Obsidian.</p>
          </div>
          <div class="wu-counter"><strong>{entries.length.toString().padStart(2,"0")}</strong><span>PUBLICATIONS</span></div>
        </div>
      </header>

      <section class="wu-browser" aria-label="Explorer les write-ups">
        <label class="wu-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.9"/><path d="m16 16 5 5"/></svg>
          <input type="search" data-wu-search placeholder="Rechercher une machine, une vulnérabilité, un outil…" aria-label="Rechercher dans les write-ups" autocomplete="off"/>
          <span class="wu-shortcut" aria-hidden="true">/</span>
        </label>
        {filters.map(group=>(
          <div class="wu-filter-group" data-wu-filter-group={group.key}>
            <span class="wu-filter-label">{group.label}</span>
            <div class="wu-chips" role="group" aria-label={"Filtrer par "+group.label.toLowerCase()}>
              <button type="button" class="wu-chip is-active" data-wu-filter={group.key} data-wu-value="" aria-pressed="true">Tous</button>
              {group.values.map(value=><button type="button" class="wu-chip" data-wu-filter={group.key} data-wu-value={value} aria-pressed="false">{value}<span>{entries.filter(e=>e[group.key]===value).length}</span></button>)}
            </div>
          </div>
        ))}
        <div class="wu-status-line">
          <span data-wu-count aria-live="polite">{entries.length} article{entries.length===1?"":"s"}</span>
          <button class="wu-reset" type="button" data-wu-reset hidden>Effacer les filtres ↺</button>
        </div>
        <div class="wu-grid">
          {entries.map(entry=>(
            <a class="wu-card" href={entry.href} data-wu-entry
              data-wu-searchable={[entry.title,entry.summary,entry.platform,entry.section,entry.category,entry.difficulty,...entry.tags].join(" ")}
              data-wu-category={entry.category} data-wu-platform={entry.platform} data-wu-section={entry.section}>
              <div class="wu-card-top">
                <span class="wu-card-platform">{entry.platform}</span>
                <time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>
              </div>
              <h2>{entry.title}</h2>
              <p>{entry.summary}</p>
              <div class="wu-card-meta">
                <span>{entry.section} <span class="wu-dot">/</span> {entry.category}</span>
                {entry.difficulty&&<span class="wu-difficulty">{entry.difficulty}</span>}
              </div>
              <div class="wu-card-bottom">
                <div class="wu-tags">{entry.tags.slice(0,4).map(tag=><span>#{tag}</span>)}</div>
                <span class="wu-arrow" aria-hidden="true">↗</span>
              </div>
            </a>
          ))}
        </div>
        {entries.length===0&&<div class="wu-empty-static"><h2>Premières publications en préparation</h2><p>Les notes validées de mon espace Pratique apparaîtront automatiquement ici.</p></div>}
        <div class="wu-no-results" data-wu-empty hidden><h2>Aucun résultat</h2><p>Essaie un autre mot-clé ou réinitialise les filtres.</p></div>
      </section>
    </div>
  </main>
</BaseLayout>
<script>
  const root = document.querySelector<HTMLElement>("[data-wu-page]");
  if (root) {
    const search = root.querySelector<HTMLInputElement>("[data-wu-search]");
    const cards = [...root.querySelectorAll<HTMLElement>("[data-wu-entry]")];
    const count = root.querySelector<HTMLElement>("[data-wu-count]");
    const empty = root.querySelector<HTMLElement>("[data-wu-empty]");
    const reset = root.querySelector<HTMLButtonElement>("[data-wu-reset]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-wu-filter]")];
    const active: Record<string,string> = { category:"", platform:"", section:"" };
    const normalize = (s:string) => s.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().trim();
    const apply = () => {
      const q = normalize(search?.value || "");
      let shown = 0;
      cards.forEach(card => {
        const fits = (!q || normalize(card.dataset.wuSearchable || "").includes(q)) &&
          Object.entries(active).every(([key,value])=>!value || card.dataset["wu"+key.charAt(0).toUpperCase()+key.slice(1)]===value);
        card.hidden = !fits;
        if (fits) shown++;
      });
      if (count) count.textContent = shown + " article" + (shown===1?"":"s");
      if (empty) empty.hidden = shown>0 || cards.length===0;
      if (reset) reset.hidden = !q && Object.values(active).every(value=>!value);
    };
    buttons.forEach(button=>button.addEventListener("click",()=>{
      const key=button.dataset.wuFilter!;
      active[key]=button.dataset.wuValue || "";
      buttons.filter(b=>b.dataset.wuFilter===key).forEach(b=>{
        const selected=b===button;
        b.classList.toggle("is-active",selected);
        b.setAttribute("aria-pressed",String(selected));
      });
      apply();
    }));
    search?.addEventListener("input",apply);
    reset?.addEventListener("click",()=>{
      if (search) search.value="";
      Object.keys(active).forEach(key=>{active[key]="";const all=buttons.find(b=>b.dataset.wuFilter===key && b.dataset.wuValue==="");all?.click()});
      apply();
      search?.focus();
    });
    document.addEventListener("keydown",event=>{
      if(event.key!=="/" || event.altKey || event.ctrlKey || event.metaKey) return;
      const element=event.target as HTMLElement | null;
      if (element?.matches("input,textarea,[contenteditable]")) return;
      event.preventDefault();
      search?.focus();
    });
  }
</script>