---
import {getCollection} from "astro:content";
import ArchiveCollection from "../../components/ArchiveCollection.astro";
import {formatDate,slugFromId} from "../../lib/content";
const rawBase=import.meta.env.BASE_URL;
const base=rawBase.endsWith("/")?rawBase:rawBase+"/";
const entries=(await getCollection("writeups")).filter(e=>e.data.status==="published").sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime()).map(e=>({
 title:e.data.title,summary:e.data.summary,kind:e.data.platform||"WRITEUP",tags:e.data.tags,href:base+"writeups/"+slugFromId(e.id)+"/",date:e.data.publishedAt,dateText:formatDate(e.data.publishedAt)
}));
---
<ArchiveCollection title="Writeups" overline="FIELD NOTES / WRITEUPS" description="Des investigations méthodiques : reconnaissance, hypothèses, validations, exploitation autorisée, erreurs et enseignements défensifs." entries={entries} kind="writeups" />
