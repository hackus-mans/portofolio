---
import { getCollection, render } from "astro:content";
import EntryLayout from "../../layouts/EntryLayout.astro";
import { slugFromId } from "../../lib/content";

export async function getStaticPaths() {
  const entries = (await getCollection("writeups")).filter((entry) => entry.data.status === "published");
  return entries.map((entry) => ({
    params: { slug: slugFromId(entry.id) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<EntryLayout
  title={entry.data.title}
  summary={entry.data.summary}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  category="Writeups"
  categoryHref="writeups/"
  meta={[
    ...(entry.data.platform ? [{ label: "Plateforme", value: entry.data.platform }] : []),
    ...(entry.data.difficulty ? [{ label: "Niveau", value: entry.data.difficulty }] : [])
  ]}
>
  <Content />
</EntryLayout>
