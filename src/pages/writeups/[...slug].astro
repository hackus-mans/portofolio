---
import { getCollection, render } from "astro:content";
import EntryLayout from "../../layouts/EntryLayout.astro";
import { slugFromId } from "../../lib/content";
import "../../styles/writeups.css";

export async function getStaticPaths() {
  const entries = (await getCollection("writeups")).filter((entry) => entry.data.status === "published");
  return entries.map((entry) => ({
    params: { slug: slugFromId(entry.id) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3).slice(0,25);
---
<EntryLayout
  title={entry.data.title}
  summary={entry.data.summary}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  toc={toc}
  category="Writeups"
  categoryHref="writeups/"
  meta={[
    ...(entry.data.platform ? [{ label: "Plateforme", value: entry.data.platform }] : []),
    ...(entry.data.difficulty ? [{ label: "Niveau", value: entry.data.difficulty }] : []),
    ...(entry.data.category ? [{ label: "Domaine", value: entry.data.category }] : []),
    ...(entry.data.section ? [{ label: "Type", value: entry.data.section === "LABs" ? "Laboratoire" : entry.data.section === "Challenges" ? "Challenge" : entry.data.section }] : []),
    ...(entry.data.service ? [{ label: "Service / technologie", value: entry.data.service }] : []),
    ...(entry.data.os ? [{ label: "Système", value: entry.data.os }] : []),
    ...(entry.data.tools?.length ? [{ label: "Outils", value: entry.data.tools.join(" · ") }] : []),
    ...(entry.data.competitionName ? [{ label: "Compétition CTF", value: entry.data.competitionName }] : []),
    ...(entry.data.challengeCategory ? [{ label: "Catégorie du challenge", value: entry.data.challengeCategory }] : []),
    ...(entry.data.activity ? [{ label: "Activité", value: entry.data.activity }] : [])
  ]}
>
  <Content />
</EntryLayout>
