---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {adminContent} from "../../lib/adminContent";
import type {ProjectRecord} from "../../lib/adminContent";

export function getStaticPaths(){
  return adminContent.projects.filter(p=>p.status==="published").map(project=>({
    params:{slug:project.slug},props:{project}
  }));
}
const {project}=Astro.props as {project:ProjectRecord};
const base=import.meta.env.BASE_URL.endsWith("/")?import.meta.env.BASE_URL:import.meta.env.BASE_URL+"/";
---
<BaseLayout title={project.title+" — Joseph NAKORE"} description={project.summary}>
<main id="main-content">
  <header class="page-hero"><div class="container">
    <a href={base+"projects/"} class="back-link">← Tous les projets</a>
    <p class="label-dark">PROJET / {project.category}</p>
    <h1>{project.title}<span>.</span></h1>
    <p class="lead">{project.summary}</p>
    <div class="hero-foot"><span>{project.stage||"Projet personnel"}</span><span>Publié depuis le portail</span></div>
  </div></header>
  <div class="container case-grid">
    <div class="case-body">
      {[
        {number:"01",id:"problem",title:"Le problème",content:project.problem},
        {number:"02",id:"approach",title:"Conception et méthodologie",content:project.approach},
        {number:"03",id:"results",title:"Résultats et preuves",content:project.results},
        {number:"04",id:"next",title:"Limites et prochaines étapes",content:project.next}
      ].filter(s=>s.content?.trim()).map(section=>
        <section class="case-section" id={section.id}>
          <p class="mono-kicker">{section.number} / PROJECT NOTES</p>
          <h2>{section.title}</h2>
          <p style="white-space:pre-wrap">{section.content}</p>
        </section>
      )}
      {project.link&&<a class="button" href={project.link} target="_blank" rel="noopener noreferrer">Documentation ou dépôt ↗</a>}
      <div class="case-pilltags">{project.technologies.map(tag=><span>{tag}</span>)}</div>
    </div>
    <aside class="case-aside"><h3>Projet</h3><dl>
      <div><dt>Nom</dt><dd>{project.title}</dd></div>
      <div><dt>Domaine</dt><dd>{project.category}</dd></div>
      <div><dt>Statut</dt><dd>{project.stage}</dd></div>
      <div><dt>Mise à jour</dt><dd>{project.updatedAt}</dd></div>
    </dl><a class="button" href={base+"projects/"}>Tous les projets ↗</a></aside>
  </div>
</main>
</BaseLayout>
