---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {site} from "../../config";
const roadmapUrl="https://hackus-mans.github.io/roadmap/";
const rawBase=import.meta.env.BASE_URL;
const base=rawBase.endsWith("/")?rawBase:rawBase+"/";
---
<BaseLayout title="Lumina Academy — Joseph NAKORE" description={site.roadmap.description}>
  <main id="main-content">
    <header class="page-hero">
      <div class="container">
        <a class="back-link" href={base}>← Retour à l'accueil</a>
        <p class="label-dark">LEARNING ENGINEERING / PROJECT 03</p>
        <h1>Lumina<br />Academy<span style="color:var(--volt)">.</span></h1>
        <p class="lead">{site.roadmap.description}</p>
        <div class="hero-foot">{site.roadmap.stats.map(s=><span>{s.value} / {s.label}</span>)}</div>
      </div>
    </header>
    <section class="container section-pad">
      <div class="section-head">
        <div><p class="mono-kicker">01 / LIVE ROADMAP</p><h2>Explorer<br />les connexions.</h2></div>
        <div><p>La roadmap est un projet autonome. Tu peux l'explorer ci-dessous ou l'ouvrir dans un nouvel onglet si l'intégration ne se charge pas.</p><a class="button" href={roadmapUrl} target="_blank" rel="noopener noreferrer">Ouvrir en plein écran <span class="arrow" aria-hidden="true">↗</span></a></div>
      </div>
      <div class="roadmap-embed">
        <div class="roadmap-embed-header"><span>EXTERNAL APP / LUMINA ACADEMY</span><span>INTEGRATION</span></div>
        <iframe src={roadmapUrl} loading="lazy" title="Roadmap interactive Lumina Academy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <a class="inline-link" href={base+"projects/lumina-academy/"}>Lire l'étude de cas Lumina Academy <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>
