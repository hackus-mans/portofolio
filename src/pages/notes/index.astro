---
import {getCollection} from "astro:content";
import ArchiveCollection from "../../components/ArchiveCollection.astro";
import {formatDate,slugFromId} from "../../lib/content";
const rawBase=import.meta.env.BASE_URL;
const base=rawBase.endsWith("/")?rawBase:rawBase+"/";
const entries=(await getCollection("notes")).filter(e=>e.data.status==="published").sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime()).map(e=>({
 title:e.data.title,summary:e.data.summary,kind:e.data.topic,tags:e.data.tags,href:base+"notes/"+slugFromId(e.id)+"/",date:e.data.publishedAt,dateText:formatDate(e.data.publishedAt)
}));
---
<ArchiveCollection title="Notes" overline="FIELD NOTES / KNOWLEDGE BASE" description="Une documentation personnelle construite sur la durée : concepts, commandes expliquées, checklists et méthodes réutilisables." entries={entries} kind="notes" />
