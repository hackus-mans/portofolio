---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { site } from "../config";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<BaseLayout title={site.name + " — Cybersécurité"} description={site.intro}>
  <Nav />

  <main class="clean-home">
    <section class="clean-hero shell">
      <div class="clean-hero-copy">
        <p class="clean-overline">{site.location} · Cybersécurité</p>
        <h1>Joseph NAKORE</h1>
        <h2>Pentest, sécurité systèmes/réseaux et SOC.</h2>
        <p class="clean-intro">
          Étudiant en cybersécurité à IPNET Institute of Technology, je construis mes compétences par la pratique :
          comprendre les systèmes, analyser les mécanismes, tester dans des environnements autorisés et documenter clairement les résultats.
        </p>

        <div class="clean-actions">
          <a class="clean-primary" href="#projects">Voir mes projets</a>
          <a class="clean-secondary" href={base + "roadmap/"}>Explorer ma roadmap ↗</a>
        </div>
      </div>

      <aside class="clean-summary" aria-label="Résumé du profil">
        <div>
          <span>FORMATION</span>
          <strong>Licence professionnelle en Cybersécurité</strong>
          <small>IPNET Institute of Technology · 2024–2027</small>
        </div>
        <div>
          <span>FOCUS</span>
          <strong>Pentest · Web/API · Linux · Windows · SOC</strong>
        </div>
        <div>
          <span>EN COURS</span>
          <strong>HTB CPTS · Hackviser CAPT</strong>
        </div>
      </aside>
    </section>

    <section class="clean-section shell" id="projects">
      <header class="clean-section-head">
        <p>01 / PROJETS</p>
        <h2>Trois preuves concrètes de progression.</h2>
      </header>

      <div class="clean-project-list">
        {site.projects.map(project => (
          <a class="clean-project" href={base + project.href}>
            <div class="clean-project-number">{project.index}</div>
            <div class="clean-project-main">
              <span>{project.type}</span>
              <h3>{project.name}</h3>
              <p>{project.summary}</p>
              <div class="clean-tags">
                {project.tags.slice(0, 5).map(tag => <span>{tag}</span>)}
              </div>
            </div>
            <div class="clean-project-result">
              <small>REPÈRE</small>
              <strong>{project.outcome}</strong>
            </div>
            <div class="clean-project-arrow">↗</div>
          </a>
        ))}
      </div>
    </section>

    <section class="clean-section shell" id="skills">
      <header class="clean-section-head">
        <p>02 / COMPÉTENCES</p>
        <h2>Ce que je travaille réellement.</h2>
      </header>

      <div class="clean-skill-list">
        {site.capabilities.map(capability => (
          <article class="clean-skill">
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
            <div class="clean-tags">
              {capability.tools.map(tool => <span>{tool}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="clean-section shell" id="trajectory">
      <header class="clean-section-head">
        <p>03 / PARCOURS</p>
        <h2>Formation, validations et objectifs actuels.</h2>
      </header>

      <div class="clean-trajectory">
        <article>
          <span class="clean-label">FORMATION</span>
          <h3>{site.education.program}</h3>
          <p>{site.education.school}</p>
          <dl>
            <div><dt>Période</dt><dd>{site.education.period}</dd></div>
            <div><dt>Lieu</dt><dd>{site.education.location}</dd></div>
            <div><dt>Orientation</dt><dd>Pentest · systèmes/réseaux · SOC</dd></div>
          </dl>
        </article>

        <article>
          <span class="clean-label">CERTIFICATIONS OBTENUES</span>
          <ul>
            {site.certifications.map(cert => <li>{cert}</li>)}
          </ul>
          <div class="clean-targets">
            <span class="clean-label">EN PRÉPARATION</span>
            <p>{site.currentTargets.join(" · ")}</p>
          </div>
        </article>
      </div>

      <div class="clean-results">
        <span>Résultats</span>
        <strong>1er Prix JPOPE 2026</strong>
        <strong>Top 1 ×2 en CTF</strong>
        <strong>Top 3 Cyberbattle IPNET</strong>
      </div>
    </section>

    <section class="clean-roadmap shell">
      <div>
        <p class="clean-overline">04 / ROADMAP</p>
        <h2>Lumina Academy</h2>
        <p>{site.roadmap.description}</p>
      </div>
      <a class="clean-primary" href={base + "roadmap/"}>Ouvrir la roadmap ↗</a>
    </section>

    <section class="clean-contact shell">
      <div>
        <p class="clean-overline">05 / CONTACT</p>
        <h2>Voir le travail public ou me contacter.</h2>
      </div>
      <div class="clean-actions">
        <a class="clean-primary" href={site.social[1].href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a class="clean-secondary" href={site.social[0].href} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </section>
  </main>

  <footer class="clean-footer">
    <div class="shell">
      <span>{site.name}</span>
      <span>{site.location} · 2026</span>
    </div>
  </footer>
</BaseLayout>
