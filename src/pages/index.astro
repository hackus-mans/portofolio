---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemDiagram from "../components/SystemDiagram.astro";
import ThreatLens from "../components/ThreatLens.astro";
import { site } from "../config";
import { formatDate, slugFromId } from "../lib/content";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const [w,l,n] = await Promise.all([getCollection("writeups"),getCollection("labs"),getCollection("notes")]);
const hubs = [
 {title:"Writeups",number:"01",entries:w.filter(e=>e.data.status==="published"),href:"writeups/",description:"Vulnérabilités, méthodes, raisonnements et documentation."},
 {title:"Labs",number:"02",entries:l.filter(e=>e.data.status==="published"),href:"labs/",description:"Systèmes, réseau, SOC et expériences reproductibles."},
 {title:"Notes",number:"03",entries:n.filter(e=>e.data.status==="published"),href:"notes/",description:"Synthèses techniques et connaissances structurées."}
];
const recent = [
 ...hubs[0].entries.map(e=>({title:e.data.title,summary:e.data.summary,date:e.data.publishedAt,kind:"WRITEUP",href:base+"writeups/"+slugFromId(e.id)+"/"})),
 ...hubs[1].entries.map(e=>({title:e.data.title,summary:e.data.summary,date:e.data.publishedAt,kind:"LAB",href:base+"labs/"+slugFromId(e.id)+"/"})),
 ...hubs[2].entries.map(e=>({title:e.data.title,summary:e.data.summary,date:e.data.publishedAt,kind:"NOTE",href:base+"notes/"+slugFromId(e.id)+"/"}))
].sort((a,b)=>b.date.getTime()-a.date.getTime()).slice(0,3);
---
<BaseLayout title={site.name+" — Offensive × Defensive Security"} description={site.intro}>
<main id="main-content">
  <section class="home-hero" id="overview">
    <div class="container home-hero-inner">
      <div class="hero-copy">
        <p class="hero-topline"><span class="hero-dot" aria-hidden="true"></span> JOSEPH NAKORE <span aria-hidden="true">/</span> LOMÉ, TOGO <span aria-hidden="true">/</span> CYBERSECURITY ENGINEERING</p>
        <h1 class="hero-title">BREAK<span class="stroke">TO LEARN.</span><span class="accent">BUILD</span>TO DEFEND.</h1>
        <p class="hero-lead">Je questionne les systèmes, j'étudie leurs failles et je construis des outils pour mieux les défendre.</p>
        <p class="hero-text">Étudiant en cybersécurité à IPNET, je développe une pratique exigeante du pentest, du SOC et de l'ingénierie. Ce portfolio rassemble mes réalisations, mon travail de laboratoire et mes analyses — avec leurs preuves et leurs limites.</p>
        <div class="hero-buttons">
          <a class="button" href="#selected">Explorer mon travail <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="button outline" href={base+"projects/"}>Tous mes projets <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-end">
          <span>NO BLACK BOXES.<br />JUST OBSERVATION, TESTING AND PROOF.</span>
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 3v25m0 0L6 18m10 10l10-10" stroke="currentColor" stroke-width="1.5"/></svg>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-visual-head"><span>NAKORE / RESEARCH INTERFACE</span><span>FIG. 001</span></div>
        <SystemDiagram />
        <div class="hero-visual-foot"><span>OFFENSE ↔ DEFENSE ↔ ENGINEERING</span><span>10°N / 01°E</span></div>
      </div>
    </div>
  </section>
  <section class="proofline" aria-label="Repères de mon parcours">
    <div class="container proofline-inner">
      {site.proof.map(p=><div class="proofstat"><strong>{p.value}</strong><span>{p.label}</span><small>{p.detail}</small></div>)}
    </div>
  </section>
  <section class="section-pad dark" id="selected">
    <div class="container">
      <div class="section-head">
        <div><p class="mono-kicker">01 / SELECTED SYSTEMS</p><h2>Ce que je <em style="font-style:normal;color:var(--volt)">construis.</em></h2></div>
        <p>Des prototypes, des laboratoires et des outils pédagogiques. Chaque réalisation documente une question technique, l'approche retenue et le niveau de validation réellement atteint.</p>
      </div>
      <div class="project-showcase">
        {site.projects.map(project=><a class="project-feature" href={base+project.href}>
          <span class="project-index">{project.index} / 05</span>
          <div class="project-feature-main"><span>{project.type}</span><h3>{project.name}</h3><p>{project.summary}</p></div>
          <div class="project-feature-art"><span>{project.slug==="mcp-automation"?"AI / MCP":project.slug==="lumina-academy"?"LUMINA":project.slug==="labs-ctf"?"RECON / CTF":project.name}</span><small>{project.status} ↗</small></div>
        </a>)}
      </div>
      <a class="inline-link" href={base+"projects/"}>Voir les cinq dossiers projets <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="section-pad" id="expertise">
    <div class="container split-story">
      <div class="story-side">
        <p class="mono-kicker">02 / CAPABILITIES</p>
        <h2>L'offensif.<br />Le défensif.<br /><span style="color:#638236">Le lien.</span></h2>
        <p>Je préfère comprendre pourquoi une commande fonctionne, quel événement elle produit et comment détecter ou corriger la faiblesse sous-jacente.</p>
        <a class="inline-link" href={base+"labs/"}>Voir la pratique technique <span aria-hidden="true">↗</span></a>
      </div>
      <div class="skill-list">
        {site.capabilities.map((cap,i)=><article class="skill-row">
          <span class="skill-number">{String(i+1).padStart(2,"0")}</span>
          <div><h3>{cap.title}</h3><strong>{cap.summary}</strong><p>{cap.description}</p><div class="skill-tags">{cap.tools.map(t=><span>{t}</span>)}</div></div>
        </article>)}
      </div>
    </div>
  </section>
  <section class="lens-section" id="lab">
    <div class="container lens-layout">
      <div>
        <p class="mono-kicker" style="color:var(--volt)">03 / INTERACTIVE FIELD LAB</p>
        <h2>Don't just<br />read. <span style="color:var(--volt)">Inspect.</span></h2>
        <p>Quelques scénarios pédagogiques pour découvrir comment transformer des faits techniques en hypothèses testables. Ils sont simulés : aucun serveur, aucune cible et aucune exploitation réelle.</p>
        <a class="inline-link" style="color:var(--volt)" href={base+"labs/"}>Explorer mes labs documentés <span aria-hidden="true">↗</span></a>
      </div>
      <ThreatLens />
    </div>
  </section>
  <section class="section-pad" id="knowledge">
    <div class="container">
      <div class="section-head">
        <div><p class="mono-kicker">04 / OPEN KNOWLEDGE</p><h2>La connaissance<br />laisse des <span style="color:#648337">traces.</span></h2></div>
        <p>Je documente aussi les erreurs, les hypothèses rejetées et les mécanismes défensifs — pas seulement les résultats finaux.</p>
      </div>
      <div class="knowledge-grid">
        {hubs.map(h=><a class="knowledge-tile" href={base+h.href}>
          <div class="knowledge-tile-top"><span>{h.number} / ARCHIVE</span><span aria-hidden="true">↗</span></div>
          <h3>{h.title}</h3><p>{h.description}</p>
          <strong>{h.entries.length} publication{h.entries.length>1?"s":""}</strong>
        </a>)}
      </div>
      {recent.length>0&&<div class="recent-list">
        <div class="recent-list-head"><h3>Dernières publications</h3><span>FIELD NOTES / LATEST</span></div>
        {recent.map(r=><a class="recent-entry" href={r.href}>
          <b>{r.kind}</b><div><h4>{r.title}</h4><p>{r.summary}</p></div><time datetime={r.date.toISOString()}>{formatDate(r.date)}</time><span aria-hidden="true">↗</span>
        </a>)}
      </div>}
    </div>
  </section>
  <section class="section-pad journey-section" id="journey">
    <div class="container journey-grid">
      <div><p class="mono-kicker">05 / THE JOURNEY</p><h2>Une ambition.<br />Du travail.<br />Des preuves.</h2><p>Une progression continue entre les fondamentaux systèmes et réseaux, le pentest, la détection et l'ingénierie. Ce qui est en préparation est affiché comme tel.</p></div>
      <div class="journey-items">
        <div class="journey-item"><span>ÉTUDES / {site.education.period}</span><h3>{site.education.program}</h3><p>{site.education.school} — {site.education.location}</p></div>
        <div class="journey-item"><span>DISTINCTION</span><h3>1er Prix · JPOPE 2026</h3><p>HoneyShield — projet honeypot orienté détection</p></div>
        <div class="journey-item"><span>CERTIFICATIONS DÉCLARÉES</span><ul>{site.certifications.map(c=><li>{c}</li>)}</ul></div>
        <div class="journey-item"><span>EN PRÉPARATION</span><h3>{site.currentTargets.join(" / ")}</h3><p>Objectifs en cours, distincts des certifications acquises.</p></div>
      </div>
    </div>
  </section>
  <section class="wide-statement" id="contact">
    <div class="container">
      <p class="mono-kicker" style="color:var(--volt)">READY FOR THE NEXT CHALLENGE?</p>
      <h2 class="statement">LET'S BUILD<br /><em>SOMETHING.</em></h2>
      <a class="button vivid" href={site.social[1].href} target="_blank" rel="noopener noreferrer">Prendre contact sur LinkedIn <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</main>
</BaseLayout>
