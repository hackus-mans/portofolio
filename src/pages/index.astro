---
import AtlasLayout from "../layouts/AtlasLayout.astro";
import AtlasExplorer from "../components/AtlasExplorer.astro";
import { site } from "../config";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const projects = site.projects;
const method = [
 ["01","OBSERVE","Inventorier l'environnement et les traces qu'il révèle."],
 ["02","HYPOTHESIZE","Formuler une explication réfutable."],
 ["03","VALIDATE","Tester dans un périmètre autorisé et documenter."],
 ["04","ENGINEER","Construire une réponse reproductible."]
];
---
<AtlasLayout>
  <header class="n-top">
    <a class="n-id" href={base} aria-label="Joseph NAKORE, accueil">
      <span class="n-mark" aria-hidden="true">N<span class="n-mark-sup">/</span></span>
      <span>NAKORE <br/><small>SECURITY OBSERVATORY</small></span>
    </a>
    <nav aria-label="Navigation principale">
      <a href="#atlas">L'ATLAS</a><a href="#cases">DOSSIERS</a><a href="#method">MÉTHODE</a><a href="#contact">CONTACT</a>
    </nav>
    <span class="n-top-status"><i aria-hidden="true"></i> LOMÉ / TOGO — 06.13° N</span>
    <a class="n-navbutton" href="#atlas">EXPLORE SYSTEM ↗</a>
    <details class="n-mobile-menu">
      <summary>MENU <span aria-hidden="true">≡</span></summary>
      <div>
        <a href="#atlas">ATLAS ↗</a>
        <a href="#cases">DOSSIERS ↗</a>
        <a href="#method">MÉTHODE ↗</a>
        <a href={base+"projects/"}>TOUS LES PROJETS ↗</a>
        <a href={base+"writeups/"}>WRITEUPS ↗</a>
        <a href={base+"about/"}>À PROPOS ↗</a>
        <a href="#contact">CONTACT ↗</a>
      </div>
    </details>
  </header>
  <main id="main-content">
    <section class="n-hero" aria-labelledby="atlas-title">
      <div class="n-hero-text">
        <div class="n-hero-meta"><span><i aria-hidden="true"></i>PORTFOLIO / ENGINEERING</span><span>LEARNING SINCE 2024</span></div>
        <h1 id="atlas-title">EVERY<br/><span>SYSTEM</span><br/>LEAVES<br/>A <em>TRACE.</em></h1>
        <div class="n-hero-bottom">
          <p>J'explore les systèmes là où l'offensif rencontre le défensif. Des vulnérabilités aux signaux qui les révèlent — jusqu'aux solutions qui les corrigent.</p>
          <a href="#atlas" class="n-roundlink" aria-label="Explorer la cartographie des projets">↗</a>
        </div>
        <div class="n-hero-bottomline">SECURITY RESEARCH / PENTEST / DETECTION / AI ENGINEERING</div>
      </div>
      <div class="n-hero-vis">
        <div class="n-hero-vishead"><span>FIELD TELEMETRY / GRAPH 001</span><span class="n-live"><i aria-hidden="true"></i> CONCEPTUAL MODEL</span></div>
        <svg class="n-mapgraphic" viewBox="0 0 650 650" role="img" aria-label="Schéma conceptuel montrant les liens entre SOC, honeypot, IA et sécurité offensive">
          <defs>
            <pattern id="atlasgrid" width="36" height="36" patternUnits="userSpaceOnUse"><path d="M36 0H0V36" fill="none" stroke="#c1ced7" stroke-opacity=".075" stroke-width="1"/></pattern>
            <radialGradient id="atlasglow"><stop stop-color="#fc7651" stop-opacity=".3"/><stop offset="1" stop-color="#fc7651" stop-opacity="0"/></radialGradient>
          </defs>
          <rect width="650" height="650" fill="url(#atlasgrid)"/>
          <circle cx="325" cy="328" r="294" fill="none" stroke="#7b96ad" stroke-opacity=".22" stroke-dasharray="3 8"/>
          <circle cx="325" cy="328" r="222" fill="none" stroke="#9eb4c7" stroke-opacity=".24"/>
          <circle cx="325" cy="328" r="157" fill="none" stroke="#b0c4d7" stroke-opacity=".32"/>
          <circle cx="325" cy="328" r="94" fill="none" stroke="#fc7651" stroke-opacity=".67"/>
          <circle cx="325" cy="328" r="165" fill="url(#atlasglow)"/>
          <g fill="none" stroke="#7898ab" stroke-width="1.3" stroke-dasharray="6 7" opacity=".78">
            <path d="M325 328 186 151 520 223 494 482 219 526 186 151"/>
            <path d="M325 328 494 482 186 151"/>
            <path d="M325 328 219 526 520 223"/>
          </g>
          <g fill="none" stroke="#fc7651" stroke-width="1.5"><path d="M325 328 520 223"/><path d="M325 328 186 151"/></g>
          <circle cx="325" cy="328" r="45" fill="#131a24" stroke="#fc7651" stroke-width="2"/>
          <text x="325" y="323" text-anchor="middle" fill="#fff3e8" font-size="27" font-weight="750" font-family="Arial">N/</text>
          <text x="325" y="346" text-anchor="middle" fill="#ff8262" font-size="8" font-family="monospace">CORE 01</text>
          <g font-family="monospace" font-size="9" letter-spacing="1.2">
            <circle cx="186" cy="151" r="14" fill="#fc7651"/><text x="186" y="155" fill="#121822" text-anchor="middle" font-weight="700">01</text><text x="106" y="126" fill="#f1f3ed">SOC / DETECT</text>
            <circle cx="520" cy="223" r="14" fill="#a9d5e4"/><text x="520" y="227" fill="#121822" text-anchor="middle" font-weight="700">02</text><text x="532" y="199" fill="#f1f3ed">HONEYPOT</text>
            <circle cx="494" cy="482" r="14" fill="#fc7651"/><text x="494" y="486" fill="#121822" text-anchor="middle" font-weight="700">03</text><text x="505" y="508" fill="#f1f3ed">AI / MCP</text>
            <circle cx="219" cy="526" r="14" fill="#a9d5e4"/><text x="219" y="530" fill="#121822" text-anchor="middle" font-weight="700">04</text><text x="91" y="551" fill="#f1f3ed">WEB / CTF</text>
          </g>
          <path d="M41 41h40M41 41v40M610 610h-40M610 610v-40" stroke="#7898ab"/>
          <text x="36" y="614" fill="#9bb1c4" font-family="monospace" font-size="9">SYSTEM VISUALIZATION / NOT LIVE DATA</text>
        </svg>
        <div class="n-hero-visfoot"><div><small>OBSERVATION / SIGNAL</small><b>4 LINKED DISCIPLINES</b></div><div><small>MODE</small><b>LEARNING IN PUBLIC →</b></div></div>
      </div>
    </section>
    <div class="n-ticker" aria-label="Domaines de pratique"><div><span>01 / PENTEST</span><i aria-hidden="true">✳</i><span>02 / SOC</span><i aria-hidden="true">✳</i><span>03 / SECURITY ENGINEERING</span><i aria-hidden="true">✳</i><span>04 / INTELLIGENCE ARTIFICIELLE</span><i aria-hidden="true">✳</i><span>05 / KNOWLEDGE</span><i aria-hidden="true">✳</i></div></div>
    <section class="n-atlas" id="atlas" aria-labelledby="atlas-workspace-title">
      <div class="n-section-top"><span>01 / NAVIGATE THE SYSTEM</span><span>SELECT AN ACTIVE PROJECT NODE ⟶</span></div>
      <div class="n-atlas-title">
        <h2 id="atlas-workspace-title">NOT PROJECTS.<br/><em>INTERCONNECTED SYSTEMS.</em></h2>
        <p>Cinq espaces, une même méthode. Chaque nœud ouvre un véritable dossier : hypothèses, architecture, décisions, preuves et limites.</p>
      </div>
      <AtlasExplorer />
    </section>
    <section class="n-method" id="method" aria-labelledby="method-title">
      <div class="n-section-top"><span>02 / INVESTIGATION PROTOCOL</span><span>A FIELD METHODOLOGY</span></div>
      <div class="n-method-inner">
        <h2 id="method-title">THE THING<br/>BEHIND<br/><em>THE THING.</em></h2>
        <div class="n-method-steps">{method.map(step=><div><small>{step[0]} /</small><b>{step[1]}</b><p>{step[2]}</p></div>)}</div>
      </div>
    </section>
    <section id="cases" class="n-cases" aria-labelledby="case-title">
      <div class="n-section-top"><span>03 / CASE ARCHIVE</span><span>ENGINEERING FIELD LOGS</span></div>
      <h2 id="case-title">WHAT HAS BEEN <em>BUILT.</em></h2>
      <div class="n-case-list">
        {projects.map((project,i)=><a href={base + project.href}>
          <small>{String(i+1).padStart(3,"0")} / {project.type}</small>
          <b>{project.name}</b>
          <span>{project.status} ↗</span>
        </a>)}
      </div>
      <div class="n-knowledge-links">
        <span>CONTINUE EXPLORING</span>
        <a href={base+"writeups/"}>WRITEUPS ↗</a>
        <a href={base+"labs/"}>LABS ↗</a>
        <a href={base+"notes/"}>NOTES ↗</a>
        <a href={base+"roadmap/"}>ROADMAP ↗</a>
        <a href={base+"about/"}>À PROPOS ↗</a>
      </div>
    </section>
  </main>
  <footer id="contact" class="n-end">
    <span>JOSEPH NAKORE / SECURITY ENGINEERING</span>
    <h2>LET'S BUILD<br/><em>THE NEXT SYSTEM.</em></h2>
    <div class="n-footer-links"><a href={site.social[1].href} target="_blank" rel="noopener noreferrer">CONTACT LINKEDIN ↗</a><a href={site.social[0].href} target="_blank" rel="noopener noreferrer">GITHUB ↗</a><span>LOMÉ, TOGO · 2026</span></div>
  </footer>
</AtlasLayout>
