---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { site } from "../config";
import { formatDate, slugFromId } from "../lib/content";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";

const [writeups, labs, notes] = await Promise.all([
  getCollection("writeups"),
  getCollection("labs"),
  getCollection("notes")
]);

const library = [
  ...writeups.filter((entry) => entry.data.status === "published").map((entry) => ({
    kind: "WRITEUP",
    title: entry.data.title,
    summary: entry.data.summary,
    date: entry.data.publishedAt,
    href: base + "writeups/" + slugFromId(entry.id) + "/",
    tags: entry.data.tags
  })),
  ...labs.filter((entry) => entry.data.status === "published").map((entry) => ({
    kind: "LAB",
    title: entry.data.title,
    summary: entry.data.summary,
    date: entry.data.publishedAt,
    href: base + "labs/" + slugFromId(entry.id) + "/",
    tags: entry.data.tags
  })),
  ...notes.filter((entry) => entry.data.status === "published").map((entry) => ({
    kind: "NOTE",
    title: entry.data.title,
    summary: entry.data.summary,
    date: entry.data.publishedAt,
    href: base + "notes/" + slugFromId(entry.id) + "/",
    tags: entry.data.tags
  }))
].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 6);
---
<BaseLayout title={site.name + " — Portfolio cybersécurité vivant"} description={site.intro}>
  <Nav />

  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="overline"><span class="live-dot"></span>{site.location} · Cybersécurité</p>
        <h1>Un portfolio construit pour évoluer avec toute ma carrière.</h1>
        <p class="hero-role">Pentest · Sécurité systèmes/réseaux · Web/API · SOC</p>
        <p class="hero-lead">
          Je suis <strong>{site.shortName}</strong>, étudiant en cybersécurité à IPNET Institute of Technology.
          Ce site n’est pas une vitrine figée : il rassemble progressivement mes projets, labs, writeups,
          notes techniques, résultats et ma roadmap d’apprentissage.
        </p>

        <div class="actions">
          <a class="button primary" href="#featured">Voir le travail</a>
          <a class="button secondary" href={base + "writeups/"}>Explorer les writeups ↗</a>
        </div>

        <div class="hero-meta">
          <div><span>FORMATION</span><strong>Licence pro Cybersécurité · 2024–2027</strong></div>
          <div><span>EN COURS</span><strong>HTB CPTS · Hackviser CAPT</strong></div>
          <div><span>PRINCIPE</span><strong>Comprendre → Tester → Détecter → Expliquer</strong></div>
        </div>
      </div>

      <div class="portrait-wrap">
        <img src={base + "joseph-soc-v2.webp"} alt="Portrait professionnel de Joseph NAKORE dans un Security Operations Center" width="720" height="900" />
        <div class="portrait-caption">
          <span>JOSEPH NAKORE</span>
          <strong>Cybersecurity student</strong>
        </div>
      </div>
    </section>

    <section class="proof-bar">
      <div class="shell proof-grid">
        {site.proof.map((item) => (
          <article>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
            <small>{item.detail}</small>
          </article>
        ))}
      </div>
    </section>

    <section class="section shell" id="featured">
      <header class="section-head">
        <div>
          <p class="overline">01 / PROJETS SÉLECTIONNÉS</p>
          <h2>Quelques projets pour comprendre immédiatement ce que je construis.</h2>
        </div>
        <a class="text-link" href={base + "projects/"}>Tous les projets →</a>
      </header>

      <div class="project-list">
        {site.projects.map((project) => (
          <a class="project-row" href={base + project.href}>
            <span class="project-number">{project.index}</span>
            <div class="project-copy">
              <span class="entry-kind">{project.type}</span>
              <h3>{project.name}</h3>
              <p>{project.summary}</p>
              <div class="chips">{project.tags.slice(0, 5).map((tag) => <span>{tag}</span>)}</div>
            </div>
            <div class="project-proof">
              <small>REPÈRE</small>
              <strong>{project.outcome}</strong>
            </div>
            <span class="row-arrow">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section section-soft" id="library">
      <div class="shell">
        <header class="section-head">
          <div>
            <p class="overline">02 / BASE DE CONNAISSANCES</p>
            <h2>Le contenu technique s’ajoute sans refaire le site.</h2>
            <p class="section-intro">
              Chaque nouveau writeup, lab ou note est un fichier Markdown. Le site génère automatiquement sa page,
              l’ajoute à son hub et peut le faire remonter ici parmi les contenus récents.
            </p>
          </div>
        </header>

        <div class="hub-links">
          <a href={base + "writeups/"}><span>WRITEUPS</span><strong>Machines, vulnérabilités, méthodologies</strong><b>→</b></a>
          <a href={base + "labs/"}><span>LABS</span><strong>SOC, systèmes, réseau, expérimentation</strong><b>→</b></a>
          <a href={base + "notes/"}><span>NOTES</span><strong>Concepts, checklists, synthèses techniques</strong><b>→</b></a>
        </div>

        <div class="latest-list">
          {library.map((entry) => (
            <a class="library-row" href={entry.href}>
              <span class="entry-kind">{entry.kind}</span>
              <div>
                <h3>{entry.title}</h3>
                <p>{entry.summary}</p>
              </div>
              <time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>
              <span class="row-arrow">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section shell" id="skills">
      <header class="section-head">
        <div>
          <p class="overline">03 / DOMAINES DE TRAVAIL</p>
          <h2>Des compétences regroupées par capacités, pas une collection de logos.</h2>
        </div>
      </header>

      <div class="capability-list">
        {site.capabilities.map((capability, index) => (
          <article>
            <span class="cap-index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </div>
            <div class="chips">{capability.tools.map((tool) => <span>{tool}</span>)}</div>
          </article>
        ))}
      </div>
    </section>

    <section class="section section-soft">
      <div class="shell trajectory">
        <header class="section-head">
          <div>
            <p class="overline">04 / PARCOURS</p>
            <h2>Ce qui est acquis, ce qui est en cours et ce que je construis ensuite.</h2>
          </div>
        </header>

        <div class="trajectory-grid">
          <article>
            <span class="entry-kind">FORMATION</span>
            <h3>{site.education.program}</h3>
            <p>{site.education.school}</p>
            <dl>
              <div><dt>Période</dt><dd>{site.education.period}</dd></div>
              <div><dt>Lieu</dt><dd>{site.education.location}</dd></div>
              <div><dt>Orientation</dt><dd>Pentest · systèmes/réseaux · SOC</dd></div>
            </dl>
          </article>

          <article>
            <span class="entry-kind">CERTIFICATIONS OBTENUES</span>
            <ul class="plain-list">{site.certifications.map((cert) => <li>{cert}</li>)}</ul>
          </article>

          <article>
            <span class="entry-kind">OBJECTIFS ACTUELS</span>
            <div class="target-list">{site.currentTargets.map((target) => <strong>{target}</strong>)}</div>
            <p>Ces éléments sont des objectifs en préparation, distincts des certifications déjà obtenues.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section shell roadmap-teaser">
      <div>
        <p class="overline">05 / ROADMAP VIVANTE</p>
        <h2>{site.roadmap.name}</h2>
        <p>{site.roadmap.description}</p>
      </div>
      <div class="roadmap-side">
        <div class="roadmap-stats">
          {site.roadmap.stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
        </div>
        <a class="button primary" href={base + "roadmap/"}>Explorer la roadmap ↗</a>
      </div>
    </section>

    <section class="contact shell">
      <div>
        <p class="overline">CONTACT & PREUVES PUBLIQUES</p>
        <h2>Le portfolio évolue. Le travail public aussi.</h2>
        <p>GitHub pour le code et les projets. LinkedIn pour le parcours professionnel.</p>
      </div>
      <div class="actions">
        <a class="button primary" href={site.social[0].href} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a class="button secondary" href={site.social[1].href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="shell">
      <div><strong>{site.name}</strong><span>Portfolio cybersécurité vivant</span></div>
      <div><span>{site.location}</span><span>Build · Break · Detect · Document</span></div>
    </div>
  </footer>
</BaseLayout>
