---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
import { getPublications } from "../lib/publications";
const base=import.meta.env.BASE_URL.replace(/\/$/,"")+"/";
const entries=(await getPublications()).slice(0,6);
const selected=[site.projects[0],site.projects[1],site.projects[3],site.projects[2]];
const domains=[
 {id:"offense",label:"Offensive",icon:"⌖",title:"Comprendre la faille.",text:"Énumération, Web/API, Linux et CTF : observer, formuler une hypothèse et la tester dans un environnement autorisé.",tools:"Nmap · Burp Suite · Linux",href:"projects/labs-ctf/",link:"Explorer mes labs"},
 {id:"defense",label:"Défensive",icon:"◇",title:"Relier les traces.",text:"Télémétrie, détection et investigation : comprendre ce qu’une action laisse derrière elle, puis construire une réponse.",tools:"Wazuh · Suricata · Cowrie",href:"projects/cybermind-x/",link:"Découvrir CyberMind X"},
 {id:"engineering",label:"Ingénierie",icon:"⌘",title:"Construire des solutions.",text:"Python, IA et automatisation : relier les outils, tester leurs limites et rendre les méthodes réutilisables.",tools:"Python · Docker · MCP",href:"projects/mcp-automation/",link:"Voir mes expérimentations"}
];
---
<BaseLayout title="Joseph NAKORE — Cybersécurité, projets & notes de terrain" description="Étudiant en cybersécurité à Lomé. Mes projets en sécurité offensive, détection et automatisation, mes labs et ce que j’apprends en les construisant.">
<main id="main-content" class="pf-home">
  <section class="pf-hero pf-container" aria-labelledby="pf-hero-title">
    <div class="pf-hero-copy">
      <p class="pf-eyebrow"><span class="pf-status-dot" aria-hidden="true"></span> ÉTUDIANT EN CYBERSÉCURITÉ / LOMÉ, TOGO</p>
      <h1 id="pf-hero-title">Joseph<br/><span>NAKORE</span><span class="pf-hero-period">.</span></h1>
      <p class="pf-hero-line">Comprendre. Construire. <em>Sécuriser.</em></p>
      <p class="pf-hero-description">J’explore les systèmes, leurs failles et les traces qu’ils laissent. Ici, je partage mes projets, mes expériences et ce que j’en apprends.</p>
      <div class="pf-hero-actions"><a class="pf-button pf-button-primary" href="#selected-work">Explorer mes projets <span aria-hidden="true">↗</span></a><a class="pf-button pf-button-quiet" href={base+"journal/"}>Lire le journal <span aria-hidden="true">→</span></a></div>
      <div class="pf-hero-foot"><span>IPNET Institute of Technology</span><span>OFFENSIVE / DÉFENSIVE / IA</span></div>
    </div>
    <div class="pf-orbit-card">
      <div class="pf-orbit-head"><span class="pf-eyebrow">MES TERRAINS DE PRATIQUE</span><span aria-hidden="true">✳</span></div>
      <div class="pf-orbit" aria-hidden="true">
        <div class="pf-orbit-glow"></div><div class="pf-orbit-ring pf-ring-one"></div><div class="pf-orbit-ring pf-ring-two"></div><div class="pf-orbit-ring pf-ring-three"></div>
        <span class="pf-orbit-cross pf-cross-one">+</span><span class="pf-orbit-cross pf-cross-two">+</span>
        <span class="pf-orbit-node pf-node-a">⌖</span><span class="pf-orbit-node pf-node-b">◇</span><span class="pf-orbit-node pf-node-c">⌘</span>
        <div class="pf-orbit-core">N<span>SHADE / LAB NOTES</span></div>
        <span class="pf-orbit-label pf-label-a">EXPLORE</span><span class="pf-orbit-label pf-label-b">DEFEND</span><span class="pf-orbit-label pf-label-c">BUILD</span>
      </div>
      <div class="pf-domain-tabs" role="tablist" aria-label="Mes domaines de pratique">
        {domains.map((domain,i)=><button type="button" role="tab" id={"tab-"+domain.id} aria-controls={"panel-"+domain.id} aria-selected={i===0?"true":"false"} tabindex={i===0?0:-1} data-domain={domain.id}>{domain.label}</button>)}
      </div>
      {domains.map((domain,i)=><div class="pf-domain-panel" role="tabpanel" id={"panel-"+domain.id} aria-labelledby={"tab-"+domain.id} hidden={i!==0} tabindex="0"><h2>{domain.title}</h2><p>{domain.text}</p><span>{domain.tools}</span><a href={base+domain.href}>{domain.link} ↗</a></div>)}
    </div>
  </section>

  <div class="pf-practice-strip"><div class="pf-container"><span>APPRENDRE EN FAISANT</span><span>Pentest & Web/API</span><i aria-hidden="true">✦</i><span>Détection & SOC</span><i aria-hidden="true">✦</i><span>Systèmes & réseaux</span><i aria-hidden="true">✦</i><span>IA & automatisation</span></div></div>

  <section class="pf-section pf-container" id="selected-work" aria-labelledby="work-title">
    <header class="pf-section-heading"><div><p class="pf-eyebrow">01 / PROJETS SÉLECTIONNÉS</p><h2 id="work-title">De l’idée<br/><em>au système.</em></h2></div><div><p>Des projets pour résoudre, expérimenter et comprendre. Chaque dossier présente l’approche, les choix et les limites.</p><a class="pf-text-link" href={base+"projects/"}>Tous les projets ↗</a></div></header>
    <div class="pf-project-grid">
      {selected.map((p,i)=><a class:list={["pf-project", "pf-project-"+i]} href={base+p.href}>
        <div class="pf-project-visual" aria-hidden="true">
          <span class="pf-project-number">0{i+1} / {['DETECTION','HONEYPOT','AUTOMATION','LEARNING'][i]}</span>
          {i===0&&<div class="pf-soc-art"><span>COLLECTER</span><b>⌁</b><span>ANALYSER</span><b>◇</b><span>ORCHESTRER</span></div>}
          {i===1&&<div class="pf-honey-art"><span>⬡</span><strong>HoneyShield</strong><small>OBSERVER · COMPRENDRE · DÉTECTER</small></div>}
          {i===2&&<div class="pf-mcp-art"><span>IA</span><i>↔</i><strong>MCP</strong><i>↔</i><span>Outils</span></div>}
          {i===3&&<div class="pf-lumina-art"><span>Fondations</span><i>↗</i><span>Pratique</span><i>↗</i><strong>Autonomie</strong></div>}
        </div>
        <div class="pf-project-content"><div class="pf-project-meta"><span>{p.type.split(" / ")[0]}</span><span>{p.status}</span></div><h3>{p.name}<span aria-hidden="true">↗</span></h3><p>{p.summary}</p><div class="pf-tags">{p.tags.slice(0,4).map(tag=><span>{tag}</span>)}</div></div>
      </a>)}
    </div>
  </section>

  <section class="pf-journal-section" id="journal" aria-labelledby="journal-title"><div class="pf-container pf-section">
    <header class="pf-section-heading"><div><p class="pf-eyebrow">02 / NOTES DE TERRAIN</p><h2 id="journal-title">Tester. Comprendre.<br/><em>Le garder par écrit.</em></h2></div><div><p>Notes techniques, labs et writeups. Un journal de progression, construit une expérience à la fois.</p><a class="pf-text-link" href={base+"journal/"}>Tout le journal ↗</a></div></header>
    <div class="pf-entry-list">
      {entries.map((entry,i)=><a class="pf-entry" href={entry.href}><span class="pf-entry-index">{String(i+1).padStart(2,"0")}</span><div><div class="pf-entry-meta"><span>{entry.kind}</span><time datetime={entry.date.toISOString()}>{entry.dateText}</time></div><h3>{entry.title}</h3><p>{entry.summary}</p><div class="pf-tags">{entry.tags.slice(0,3).map(tag=><span>{tag}</span>)}</div></div><span class="pf-entry-arrow" aria-hidden="true">↗</span></a>)}
      {entries.length===0&&<p>Les premières notes arrivent bientôt.</p>}
    </div>
  </div></section>

  <section class="pf-section pf-container pf-about-preview" aria-labelledby="approach-title">
    <div><p class="pf-eyebrow">03 / LA DÉMARCHE</p><h2 id="approach-title">La curiosité<br/>comme <em>point de départ.</em></h2><p>Je suis étudiant à IPNET Institute of Technology. Mon fil conducteur : comprendre comment un système fonctionne pour apprendre à le tester, le surveiller et le sécuriser.</p><a class="pf-text-link" href={base+"about/"}>Mon parcours et mes compétences ↗</a></div>
    <ol class="pf-method"><li><span>01</span><div><h3>Observer & questionner</h3><p>Partir de faits, comprendre le contexte et formuler une hypothèse.</p></div></li><li><span>02</span><div><h3>Construire & expérimenter</h3><p>Mettre les concepts à l’épreuve dans des labs et des projets.</p></div></li><li><span>03</span><div><h3>Expliquer & transmettre</h3><p>Documenter le résultat, les erreurs et les limites pour pouvoir recommencer seul.</p></div></li></ol>
  </section>

  <section class="pf-container pf-atlas-teaser" aria-labelledby="atlas-title"><div class="pf-atlas-symbol" aria-hidden="true">◎</div><div><p class="pf-eyebrow">UN AUTRE ANGLE DE VUE</p><h2 id="atlas-title">Tout est connecté.</h2><p>Explore les relations entre mes projets, leurs outils et les scénarios de lab dans la constellation interactive.</p></div><a class="pf-button" href={base+"atlas/"}>Explorer l’Atlas ↗</a></section>

  <section class="pf-section pf-container pf-contact-band" aria-labelledby="contact-title"><p class="pf-eyebrow">ET SI ON CONSTRUISAIT LA SUITE ?</p><h2 id="contact-title">Une idée à explorer.<br/><em>Une conversation à lancer.</em></h2><a class="pf-button pf-button-primary" href={base+"contact/"}>Entrer en contact ↗</a></section>
</main>
</BaseLayout>
<script>
const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>("[data-domain]"));
const select=(tab:HTMLButtonElement)=>{tabs.forEach(t=>{const active=t===tab;t.setAttribute("aria-selected",String(active));t.tabIndex=active?0:-1;const panel=document.getElementById("panel-"+t.dataset.domain);if(panel)panel.hidden=!active});document.querySelector(".pf-orbit-card")?.setAttribute("data-active",tab.dataset.domain||"offense")};
tabs.forEach((tab,index)=>{tab.addEventListener("click",()=>select(tab));tab.addEventListener("keydown",event=>{let next=index;if(event.key==="ArrowRight")next=(index+1)%tabs.length;else if(event.key==="ArrowLeft")next=(index+tabs.length-1)%tabs.length;else if(event.key==="Home")next=0;else if(event.key==="End")next=tabs.length-1;else return;event.preventDefault();select(tabs[next]);tabs[next].focus()})});
</script>
