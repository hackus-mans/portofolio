---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { site } from "../config";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<BaseLayout title={site.name + " — Pentest, SOC & sécurité systèmes/réseaux"} description={site.intro}>
  <Nav />

  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <div class="status-line">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{site.location}</span>
          <span class="separator">/</span>
          <span>Cybersecurity student</span>
        </div>

        <h1>{site.headline}</h1>
        <p class="hero-lead">{site.intro}</p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="#projects">Voir les projets <span>↓</span></a>
          <a class="btn btn-secondary" href={base + "roadmap/"}>Explorer la roadmap <span>↗</span></a>
        </div>

        <div class="hero-links" aria-label="Profils publics">
          {site.social.map(item => (
            <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label} ↗</a>
          ))}
        </div>
      </div>

      <aside class="profile-card" aria-label="Résumé du profil">
        <div class="profile-card-top">
          <div class="monogram">JN</div>
          <div>
            <small>PROFIL</small>
            <strong>{site.shortName}</strong>
          </div>
        </div>

        <dl class="profile-facts">
          <div><dt>Formation</dt><dd>Licence pro Cybersécurité</dd></div>
          <div><dt>École</dt><dd>IPNET Institute of Technology</dd></div>
          <div><dt>Focus</dt><dd>Pentest · SOC · Web/API</dd></div>
          <div><dt>Systèmes</dt><dd>Linux · Windows · AD</dd></div>
          <div><dt>Actuellement</dt><dd>CPTS + CAPT en préparation</dd></div>
        </dl>

        <div class="profile-principle">
          <span>PRINCIPE</span>
          <p>Comprendre le mécanisme avant d’automatiser l’outil.</p>
        </div>
      </aside>
    </section>

    <section class="proof-strip" aria-label="Repères vérifiables">
      <div class="shell proof-grid">
        {site.proof.map(item => (
          <article>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
            <small>{item.detail}</small>
          </article>
        ))}
      </div>
    </section>

    <section class="section shell audience-section">
      <div class="section-heading">
        <span class="section-index">01</span>
        <div>
          <p class="section-kicker">UNE LECTURE ADAPTÉE À CHAQUE VISITEUR</p>
          <h2>Le site doit répondre vite à la bonne question.</h2>
        </div>
      </div>

      <div class="audience-grid">
        <a class="audience-card" href="#trajectory">
          <span>Recruteur / DSI</span>
          <h3>Quel profil est-ce que je recrute ?</h3>
          <p>Formation, domaines de compétence, certifications, objectifs actuels et preuves de progression.</p>
          <strong>Voir le parcours →</strong>
        </a>
        <a class="audience-card" href="#projects">
          <span>Évaluateur technique</span>
          <h3>Qu’est-ce qu’il sait réellement faire ?</h3>
          <p>Projets, architectures, méthodologies, technologies utilisées et résultats obtenus.</p>
          <strong>Voir les preuves →</strong>
        </a>
        <a class="audience-card" href={base + "roadmap/"}>
          <span>Étudiant / pair</span>
          <h3>Comment est structuré son apprentissage ?</h3>
          <p>Une roadmap interactive ouverte aux visiteurs, avec prérequis, spécialisations et projets.</p>
          <strong>Explorer la roadmap →</strong>
        </a>
      </div>
    </section>

    <section class="section shell" id="skills">
      <div class="section-heading">
        <span class="section-index">02</span>
        <div>
          <p class="section-kicker">CAPACITÉS</p>
          <h2>Compétences organisées par ce que je peux analyser et construire.</h2>
        </div>
      </div>

      <div class="capability-grid">
        {site.capabilities.map((capability, i) => (
          <article class="capability-card">
            <div class="capability-number">{String(i + 1).padStart(2, "0")}</div>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
            <div class="tag-list">
              {capability.tools.map(tool => <span>{tool}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section projects-section" id="projects">
      <div class="shell">
        <div class="section-heading section-heading-light">
          <span class="section-index">03</span>
          <div>
            <p class="section-kicker">PROJETS & PRATIQUE</p>
            <h2>Des preuves plus utiles qu’une simple liste d’outils.</h2>
          </div>
        </div>

        <div class="project-stack">
          {site.projects.map(project => (
            <a class="project-card" href={base + project.href}>
              <div class="project-index">{project.index}</div>
              <div class="project-body">
                <p class="project-type">{project.type}</p>
                <h3>{project.name}</h3>
                <p class="project-summary">{project.summary}</p>
                <div class="tag-list tag-list-dark">
                  {project.tags.map(tag => <span>{tag}</span>)}
                </div>
              </div>
              <div class="project-outcome">
                <span>REPÈRE</span>
                <strong>{project.outcome}</strong>
              </div>
              <div class="project-arrow" aria-hidden="true">↗</div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section shell method-section">
      <div class="section-heading">
        <span class="section-index">04</span>
        <div>
          <p class="section-kicker">MÉTHODOLOGIE</p>
          <h2>Je veux être capable d’expliquer le chemin, pas seulement le résultat.</h2>
        </div>
      </div>

      <div class="method-flow" aria-label="Méthodologie de travail">
        {[
          ["01", "Observer", "Contexte, surface d’attaque, télémétrie et contraintes."],
          ["02", "Énumérer", "Services, versions, permissions, contenus et relations."],
          ["03", "Formuler", "Hypothèses techniques basées sur les preuves collectées."],
          ["04", "Valider", "Tests contrôlés, exploitation autorisée ou reproduction."],
          ["05", "Expliquer", "Cause, impact, traces, mitigation et documentation."]
        ].map(step => (
          <article>
            <span>{step[0]}</span>
            <h3>{step[1]}</h3>
            <p>{step[2]}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section shell trajectory-section" id="trajectory">
      <div class="section-heading">
        <span class="section-index">05</span>
        <div>
          <p class="section-kicker">PARCOURS & VALIDATION</p>
          <h2>Ce qui est acquis, ce qui est en cours, et où je vais.</h2>
        </div>
      </div>

      <div class="trajectory-grid">
        <article class="trajectory-primary">
          <span class="eyebrow-label">FORMATION</span>
          <h3>{site.education.program}</h3>
          <p>{site.education.school}</p>
          <dl>
            <div><dt>Période</dt><dd>{site.education.period}</dd></div>
            <div><dt>Lieu</dt><dd>{site.education.location}</dd></div>
            <div><dt>Orientation</dt><dd>Pentest · systèmes/réseaux · SOC</dd></div>
          </dl>
        </article>

        <article class="trajectory-secondary">
          <div class="trajectory-block">
            <span class="eyebrow-label">CERTIFICATIONS OBTENUES</span>
            <ul class="clean-list">
              {site.certifications.map(cert => <li><span>✓</span>{cert}</li>)}
            </ul>
          </div>
          <div class="trajectory-block targets">
            <span class="eyebrow-label">OBJECTIFS ACTUELS</span>
            <div class="target-row">
              {site.currentTargets.map(target => <strong>{target}</strong>)}
            </div>
            <p>Ces éléments sont des objectifs de formation en cours, pas des certifications déjà obtenues.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="section shell roadmap-feature">
      <div class="roadmap-copy">
        <span class="section-index">06</span>
        <p class="section-kicker">ROADMAP INTERACTIVE</p>
        <h2>{site.roadmap.name}</h2>
        <p>{site.roadmap.description}</p>
        <a class="btn btn-primary" href={base + "roadmap/"}>Ouvrir la roadmap <span>↗</span></a>
      </div>
      <div class="roadmap-stats">
        {site.roadmap.stats.map(stat => (
          <article><strong>{stat.value}</strong><span>{stat.label}</span></article>
        ))}
        <div class="roadmap-note">
          <span>LIVE</span>
          <p>La page intégrée charge directement la version publiée de la roadmap. Une mise à jour de la roadmap apparaît automatiquement ici après son déploiement.</p>
        </div>
      </div>
    </section>

    <section class="contact-section shell">
      <div>
        <p class="section-kicker">CONTACT & PREUVES PUBLIQUES</p>
        <h2>Continuer la conversation ou vérifier le travail.</h2>
        <p>LinkedIn pour le parcours professionnel. GitHub pour le code, les projets et l’activité technique publique.</p>
      </div>
      <div class="contact-actions">
        <a class="btn btn-primary" href={site.social[1].href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a class="btn btn-secondary" href={site.social[0].href} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <div>
        <strong>{site.name}</strong>
        <span>{site.role}</span>
      </div>
      <div>
        <span>{site.location}</span>
        <span>Portfolio cybersécurité · 2026</span>
      </div>
    </div>
  </footer>
</BaseLayout>
