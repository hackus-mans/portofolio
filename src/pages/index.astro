---
import "../styles/site.css";
import contenu from "../data/contenu.json";

type Projet = { titre: string; description: string; url: string; technologies: string[] };
type Lien = { nom: string; url: string };
const projets = contenu.projets as Projet[];
const liens = contenu.liens as Lien[];
const aDuContenu = Boolean(contenu.sousTitre.trim() || contenu.presentation.trim() || projets.length || liens.length);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c111b" />
    <meta name="description" content={contenu.sousTitre || "Portfolio personnel en cours de construction."} />
    <link rel="canonical" href={"https://hackus-mans.github.io"+base} />
    <title>{contenu.titre}</title>
  </head>
  <body>
    <div class="page">
      <header class="topbar">
        <a class="brand" href={base}>{contenu.titre}</a>
        {liens.length > 0 && <nav aria-label="Mes liens">
          {liens.map(lien => <a href={lien.url} rel="noopener noreferrer">{lien.nom}</a>)}
        </nav>}
      </header>
      <main id="main-content">
        <section class="intro" aria-labelledby="page-title">
          <span class="eyebrow"><span class="dot" aria-hidden="true"></span> Portfolio personnel</span>
          <h1 id="page-title">{contenu.titre}</h1>
          {contenu.sousTitre && <p class="lead">{contenu.sousTitre}</p>}
          {!aDuContenu && <p class="empty">En construction. Le contenu sera ajouté prochainement.</p>}
        </section>
        {contenu.presentation && <section class="section" aria-labelledby="about-title">
          <h2 id="about-title">Présentation</h2>
          <p class="prose">{contenu.presentation}</p>
        </section>}
        {projets.length > 0 && <section class="section" aria-labelledby="projects-title">
          <h2 id="projects-title">Projets</h2>
          <div class="projects">
            {projets.map(projet => <article class="project">
              <h3>{projet.titre}</h3>
              {projet.description && <p>{projet.description}</p>}
              {projet.technologies?.length > 0 && <div class="tags">{projet.technologies.map(tech => <span>{tech}</span>)}</div>}
              {projet.url && <a href={projet.url} rel="noopener noreferrer">Découvrir le projet <span aria-hidden="true">↗</span></a>}
            </article>)}
          </div>
        </section>}
      </main>
      <footer>
        <span>{contenu.titre}</span>
        <span>Site personnel</span>
      </footer>
    </div>
  </body>
</html>
