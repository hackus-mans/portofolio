---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const target = base + "projects/cybermind-x/";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={"0;url=" + target} />
    <link rel="canonical" href={target} />
    <title>Redirection — CyberMind X</title>
  </head>
  <body>
    <p>Redirection vers <a href={target}>CyberMind X</a>…</p>
  </body>
</html>
