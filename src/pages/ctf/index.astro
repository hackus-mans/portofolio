---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShadeBrowser from "../../components/ShadeBrowser.astro";
import {getCollection} from "astro:content";
import {slugFromId,formatDate} from "../../lib/content";
import "../../styles/shade-sections.css";

const base=import.meta.env.BASE_URL.replace(/\/?$/,"/"); 
const all=await getCollection("ctf");
const competitions=all.filter(c=>c.data.status==="published")
  .sort((a,b)=>a.data.title.localeCompare(b.data.title,"fr"));
const entries=competitions.map(c=>({
 title:c.data.title,
 summary:c.data.summary,
 topline:"CTF / COMPÉTITION",
 date:c.data.generated?"":formatDate(c.data.publishedAt),
 href:base+"ctf/"+slugFromId(c.id).replace(/^obsidian\//,"")+"/",
 badges:c.data.generated?["Dossier de compétition"]:[c.data.organizer,c.data.team,c.data.rank].filter(Boolean),
 tags:c.data.tags,
 facets:{year:c.data.generated?"":String(c.data.publishedAt.getFullYear())}
}));
const years=[...new Set(entries.map(c=>c.facets.year).filter(Boolean))].sort((a,b)=>b.localeCompare(a));
---
<BaseLayout title="CTF — Joseph NAKORE" description="Compétitions Capture The Flag : dossiers, catégories et write-ups techniques.">
  <main class="shade-section-page" id="main-content"><div class="shade-wide">
    <ShadeBrowser
      eyebrow="CTF / COMPÉTITIONS"
      title="Capture The Flag"
      description="Explore mes compétitions. Ouvre un événement pour retrouver ses catégories et les challenges dont j'ai autorisé la publication."
      base={base}
      entries={entries}
      filters={[{key:"year",label:"Année",values:years}]}
      links={[{label:"Explorer tous mes write-ups",href:base+"writeups/"},{label:"Voir les challenges CTF publiés",href:base+"writeups/?type=ctf"}]}
      emptyTitle="Aucune compétition enregistrée"
      emptyText="Dès qu'un dossier de compétition sera synchronisé depuis CTF/ dans Obsidian, sa fiche apparaîtra ici. Les write-ups restent privés sans publish: true."
    />
  </div></main>
</BaseLayout>