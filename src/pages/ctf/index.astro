---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShadeBrowser from "../../components/ShadeBrowser.astro";
import {getCollection} from "astro:content";
import {slugFromId,formatDate} from "../../lib/content";
import "../../styles/shade-sections.css";
const base=import.meta.env.BASE_URL.replace(/\/?$/,"/");
const [competitions,writeups]=await Promise.all([getCollection("ctf"),getCollection("writeups")]);
const published=competitions.filter(c=>c.data.status==="published");
const challenges=writeups.filter(w=>w.data.status==="published"&&w.data.context==="CTF");
const competitionCards=published.map(c=>({
  title:c.data.title,summary:c.data.summary,topline:"COMPÉTITION CTF",date:formatDate(c.data.publishedAt),
  href:base+"ctf/"+slugFromId(c.id)+"/",
  badges:[c.data.organizer,c.data.team,c.data.rank].filter(Boolean),
  tags:c.data.tags,
  facets:{competition:c.data.title,year:String(c.data.publishedAt.getFullYear())}
}));
const challengeCards=challenges.map(w=>({
  title:w.data.title,summary:w.data.summary,topline:w.data.competitionName||"CHALLENGE CTF",date:formatDate(w.data.publishedAt),
  href:base+"writeups/"+slugFromId(w.id)+"/",
  badges:[w.data.challengeCategory||w.data.category,w.data.difficulty,"Write-up"].filter(Boolean),
  tags:w.data.tags,
  facets:{competition:w.data.competitionName||"",category:w.data.challengeCategory||w.data.category||"",platform:w.data.platform||""}
}));
const filtersFor=(cards,fields)=>fields.map(([key,label])=>({key,label,values:[...new Set(cards.map(c=>c.facets[key]).filter(Boolean))].sort((a,b)=>a.localeCompare(b,"fr"))}));
---
<BaseLayout title="CTF — Joseph NAKORE" description="Compétitions CTF et write-ups des défis publiés depuis Obsidian SHADE.">
  <main class="shade-section-page" id="main-content">
    <div class="shade-wide">
      <ShadeBrowser eyebrow="CTF / COMPÉTITIONS" title="Capture The Flag" description="Compétitions auxquelles j'ai participé, classements documentés et challenges résolus. Chaque fiche renvoie aux write-ups publiés depuis Obsidian." base={base} entries={competitionCards} filters={filtersFor(competitionCards,[["year","Année"]])} links={[{label:"Tous les write-ups",href:base+"writeups/"},{label:"Home Lab",href:base+"homelab/"}]} emptyTitle="Compétitions en préparation" emptyText="Les fiches de compétition apparaîtront ici lorsque leur propriété publish sera activée dans Obsidian."/>
      <div class="shade-subsection">
        <div class="shade-subheading"><div><div class="shade-eyebrow">~/ CHALLENGES</div><h2>Rédactions CTF <span>{challenges.length}</span></h2><p>Un seul write-up : visible ici et dans le catalogue général des Write-ups.</p></div></div>
        <ShadeBrowser eyebrow="CHALLENGES DOCUMENTÉS" title="Write-ups CTF" description="Filtrer les challenges par compétition, catégorie technique ou plateforme." base={base} entries={challengeCards} filters={filtersFor(challengeCards,[["competition","Compétition"],["category","Catégorie"],["platform","Plateforme"]])} emptyTitle="Aucun write-up CTF publié" emptyText="Crée tes notes dans CTF/Nom-de-compétition/, puis active publish pour les rendre visibles ici."/>
      </div>
    </div>
  </main>
</BaseLayout>