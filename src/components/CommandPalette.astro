---
import {site} from "../config";
const rawBase=import.meta.env.BASE_URL;
const base=rawBase.endsWith("/")?rawBase:rawBase+"/";
const commands=[
  {title:"Accueil",category:"Navigation",href:base},
  {title:"Projets",category:"Navigation",href:base+"projects/"},
  ...site.projects.map(p=>({title:p.name,category:"Étude de cas",href:base+p.href})),
  {title:"Writeups",category:"Recherche",href:base+"writeups/"},
  {title:"Labs",category:"Recherche",href:base+"labs/"},
  {title:"Notes",category:"Recherche",href:base+"notes/"},
  {title:"Lumina Academy",category:"Outil",href:base+"roadmap/"},
  {title:"À propos",category:"Navigation",href:base+"about/"},
  {title:"GitHub",category:"Réseau",href:site.social[0].href},
  {title:"LinkedIn",category:"Réseau",href:site.social[1].href}
];
---
<dialog id="site-command" class="command-dialog" aria-label="Recherche et navigation rapide">
  <div class="command-top">
    <label for="command-query" class="visually-hidden">Chercher une page ou un projet</label>
    <span aria-hidden="true">⌕</span>
    <input id="command-query" data-command-query type="search" placeholder="Rechercher une page, un projet, une ressource…" autocomplete="off" />
    <button type="button" data-command-close aria-label="Fermer le menu rapide">ESC ×</button>
  </div>
  <div class="command-results" data-command-results>
    {commands.map(item=><a href={item.href} data-command-item data-text={(item.title+" "+item.category).toLocaleLowerCase("fr")}>
      <span>{item.category}</span><strong>{item.title}</strong><span aria-hidden="true">↗</span>
    </a>)}
  </div>
  <div class="command-foot"><span>CTRL / ⌘ + K pour ouvrir</span><span>ÉCHAP pour fermer</span></div>
</dialog>
<script>
  const dialog=document.querySelector<HTMLDialogElement>("#site-command");
  const field=dialog?.querySelector<HTMLInputElement>("[data-command-query]");
  const items=Array.from(dialog?.querySelectorAll<HTMLElement>("[data-command-item]")||[]);
  const normalize=(v:string)=>v.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().trim();
  const filter=()=>{
    const q=normalize(field?.value||"");
    items.forEach(item=>{item.hidden=!normalize(item.dataset.text||"").includes(q)});
  };
  const open=()=>{if(!dialog||dialog.open)return;dialog.showModal();if(field){field.value="";filter();field.focus()}};
  document.querySelectorAll<HTMLElement>("[data-command-open]").forEach(button=>button.addEventListener("click",open));
  dialog?.querySelector<HTMLElement>("[data-command-close]")?.addEventListener("click",()=>dialog.close());
  field?.addEventListener("input",filter);
  document.addEventListener("keydown",e=>{
    const target=e.target as HTMLElement|null;
    const editing=target?.matches("input,textarea,select,[contenteditable]")??false;
    if(((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==="k")||(!editing&&e.key==="/")){
      e.preventDefault();if(dialog?.open)dialog.close();else open();
    }
  });
  dialog?.addEventListener("click",event=>{if(event.target===dialog)dialog.close()});
</script>
