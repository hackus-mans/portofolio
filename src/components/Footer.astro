---
import { site } from "../config";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<footer class="site-footer">
  <div class="container footer-main">
    <div>
      <p class="mono-kicker">END OF TRANSMISSION / 001</p>
      <h2>Curieux de construire<br /><em>quelque chose ensemble ?</em></h2>
      <a class="footer-action" href={site.social[1].href} target="_blank" rel="noopener noreferrer">Entrer en contact <span aria-hidden="true">↗</span></a>
    </div>
    <div class="footer-directory">
      <div><span>NAVIGUER</span><a href={base}>Accueil</a><a href={base+"projects/"}>Projets</a><a href={base+"writeups/"}>Writeups</a><a href={base+"labs/"}>Labs</a><a href={base+"notes/"}>Notes</a><a href={base+"roadmap/"}>Roadmap</a></div>
      <div><span>RETROUVER</span>{site.social.map(link=><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}<small>{site.location}</small></div>
    </div>
  </div>
  <div class="container footer-base">
    <strong>© {new Date().getFullYear()} JOSEPH NAKORE</strong>
    <span>LEARN / BUILD / BREAK / DEFEND</span>
    <a href={base}>Retour au début ↑</a>
  </div>
</footer>
