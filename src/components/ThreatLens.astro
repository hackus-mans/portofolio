<div class="lens-card" data-threat-lens>
  <div class="lens-tabs" role="tablist" aria-label="Sélectionner une démonstration de sécurité">
    <button id="lens-soc" type="button" role="tab" aria-controls="lens-panel" aria-selected="true" tabindex="0" data-scenario="soc">SOC SIGNAL</button>
    <button id="lens-web" type="button" role="tab" aria-controls="lens-panel" aria-selected="false" tabindex="-1" data-scenario="web">WEB / API</button>
    <button id="lens-linux" type="button" role="tab" aria-controls="lens-panel" aria-selected="false" tabindex="-1" data-scenario="linux">LINUX</button>
  </div>
  <div class="lens-content" role="tabpanel" id="lens-panel" aria-labelledby="lens-soc" tabindex="0">
    <p class="lens-terminal">analyst@nakore:~$ <span id="lens-command">inspect --scenario ssh-auth</span></p>
    <pre><code id="lens-output">[SOURCE]  SSH authentication telemetry
[EVENT]   Repeated login failures observed
[HYPOTHESIS] Potential password guessing
[TEST]    Correlate user, source and interval
[NEXT]    Investigate and assess mitigations</code></pre>
  </div>
  <div class="lens-bottom"><span>SIMULATION PÉDAGOGIQUE</span><span>Aucune cible / aucune commande exécutée</span></div>
</div>
<script>
  const root = document.querySelector<HTMLElement>("[data-threat-lens]");
  if(root) {
    const entries: Record<string,{cmd:string,lines:string}> = {
      soc:{cmd:"inspect --scenario ssh-auth",lines:"[SOURCE]  SSH authentication telemetry\n[EVENT]   Repeated login failures observed\n[HYPOTHESIS] Potential password guessing\n[TEST]    Correlate user, source and interval\n[NEXT]    Investigate and assess mitigations"},
      web:{cmd:"inspect --scenario object-auth",lines:"[REQUEST]  GET /api/resources/42\n[HYPOTHESIS] Object-level access control flaw\n[TEST]    Compare responses for test identities\n[CONTROL] Authorize access per object and role\n[NEXT]    Document reproduction and expected policy"},
      linux:{cmd:"inspect --scenario filesystem",lines:"[OBJECT]  /srv/application/config\n[OWNER]   root:app\n[MODE]    0640 / rw-r-----\n[TEST]    Check effective UID and groups\n[NEXT]    Confirm least-privilege access"}
    };
    const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const cmd=root.querySelector<HTMLElement>("#lens-command");
    const out=root.querySelector<HTMLElement>("#lens-output");
    const panel=root.querySelector<HTMLElement>("#lens-panel");
    const activate=(tab:HTMLButtonElement,focus=false)=>{
      const item=entries[tab.dataset.scenario||"soc"];if(!item)return;
      tabs.forEach(t=>{const active=t===tab;t.setAttribute("aria-selected",String(active));t.tabIndex=active?0:-1});
      if(cmd)cmd.textContent=item.cmd;if(out)out.textContent=item.lines;
      if(panel)panel.setAttribute("aria-labelledby",tab.id);
      if(focus)tab.focus();
    };
    tabs.forEach((tab,i)=>{
      tab.addEventListener("click",()=>activate(tab));
      tab.addEventListener("keydown",e=>{
        let next=i;
        if(e.key==="ArrowRight")next=(i+1)%tabs.length;
        else if(e.key==="ArrowLeft")next=(i-1+tabs.length)%tabs.length;
        else if(e.key==="Home")next=0;
        else if(e.key==="End")next=tabs.length-1;
        else return;
        e.preventDefault();activate(tabs[next],true);
      });
    });
  }
</script>
