---
import { getPublications } from "../lib/publications";
const entries = (await getPublications()).slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
---
<section class="cc-journal" id="journal" aria-labelledby="journal-title">
  <div class="cc-journal-heading">
    <div><span class="cc-section-eyebrow">LE CARNET DE BORD</span><h2 id="journal-title">Ce que j’explore.</h2></div>
    <a href={base + "journal/"}>Tout le journal <span aria-hidden="true">↗</span></a>
  </div>
  <div class="cc-publications">
    {entries.map((entry, i) => <a class="cc-publication" href={entry.href} data-searchable={[entry.title, entry.summary, ...entry.tags].join(" ")}>
      <div class="cc-publication-meta"><span>{entry.kind}</span><time datetime={entry.date.toISOString()}>{entry.dateText}</time></div>
      <h3>{entry.title}</h3><p>{entry.summary}</p>
      <div class="cc-publication-bottom"><span>{entry.tags.slice(0, 2).join(" / ")}</span><span aria-hidden="true">↗</span></div>
    </a>)}
  </div>
  {entries.length === 0 && <p>Les premières notes de terrain arrivent bientôt.</p>}
</section>
