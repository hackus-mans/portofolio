---
import { site } from "../config";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<header class="nav-shell">
  <nav class="nav wrap" aria-label="Primary navigation">
    <a class="brand" href={base}>
      <span class="brand-mark">F/</span>
      <span>FUSION</span>
    </a>
    <div class="nav-links">
      <a href={base + "#work"}>Work</a>
      <a href={base + "roadmap/"}>Roadmap</a>
      <a href={base + "#process"}>Process</a>
      <a href={base + "#about"}>About</a>
    </div>
    <div class="nav-actions">
      <div class="theme-picker" aria-label="Theme">
        <button data-set-theme="mono" title="Mono theme"><span></span></button>
        <button data-set-theme="phosphor" title="Phosphor theme"><span></span></button>
        <button data-set-theme="amber" title="Amber theme"><span></span></button>
      </div>
      <a class="terminal-trigger" href={base + "terminal/"} aria-label="Open Linux sandbox terminal">
        <span>TERMINAL</span>
      </a>
      <a class="nav-contact" href={"mailto:" + site.email}>Contact ↗</a>
    </div>
  </nav>
</header>
<script define:vars={{ terminalPath: base + "terminal/" }}>
  document.querySelectorAll("[data-set-theme]").forEach((button) => {
    button.addEventListener("click", () => {
      const theme = button.getAttribute("data-set-theme") || "mono";
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem("fusion-theme", theme); } catch {}
    });
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      window.location.href = terminalPath;
    }
  });
</script>
