---
import { site } from "../config";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<header class="nav-shell">
  <nav class="nav wrap" aria-label="Navigation principale">
    <a class="brand" href={base}>
      <span class="brand-mark">JN</span>
      <span>{site.shortName}</span>
    </a>
    <div class="nav-links">
      <a href={base + "#work"}>Projets</a>
      <a href={base + "roadmap/"}>Roadmap</a>
      <a href={base + "#skills"}>Compétences</a>
      <a href={base + "#about"}>À propos</a>
    </div>
    <div class="nav-actions">
      <div class="theme-picker" aria-label="Thème">
        <button data-set-theme="mono" title="Thème mono"><span></span></button>
        <button data-set-theme="phosphor" title="Thème phosphore"><span></span></button>
        <button data-set-theme="amber" title="Thème ambre"><span></span></button>
      </div>
      <a class="terminal-trigger" href={base + "terminal/"} aria-label="Ouvrir le terminal">
        <span>TERMINAL</span>
      </a>
      <a class="nav-contact" href={site.social[1].href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </div>
  </nav>
</header>
<script define:vars={{ terminalPath: base + "terminal/" }}>
  document.querySelectorAll("[data-set-theme]").forEach((button) => {
    button.addEventListener("click", () => {
      const theme = button.getAttribute("data-set-theme") || "mono";
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem("fusion-theme", theme); } catch {}
    });
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      window.location.href = terminalPath;
    }
  });
</script>
