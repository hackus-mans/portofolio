---
import { site } from "../config";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<header class="site-header">
  <nav class="site-nav shell" aria-label="Navigation principale">
    <a class="site-brand" href={base} aria-label="Accueil — Joseph NAKORE">
      <span class="brand-mark">JN</span>
      <span class="brand-copy">
        <strong>{site.shortName}</strong>
        <small>Cybersecurity</small>
      </span>
    </a>

    <div class="site-links">
      <a href={base + "projects/"}>Projets</a>
      <a href={base + "writeups/"}>Writeups</a>
      <a href={base + "labs/"}>Labs</a>
      <a href={base + "notes/"}>Notes</a>
      <a href={base + "roadmap/"}>Roadmap</a>
    </div>

    <a class="nav-social" href={site.social[1].href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>

    <details class="mobile-menu">
      <summary>Menu</summary>
      <div class="mobile-menu-panel">
        <a href={base + "projects/"}>Projets</a>
        <a href={base + "writeups/"}>Writeups</a>
        <a href={base + "labs/"}>Labs</a>
        <a href={base + "notes/"}>Notes</a>
        <a href={base + "roadmap/"}>Roadmap</a>
        <a href={site.social[0].href} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href={site.social[1].href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
    </details>
  </nav>
</header>
