---
import { site } from "../config";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<header class="clean-header">
  <nav class="clean-nav shell" aria-label="Navigation principale">
    <a class="clean-brand" href={base}>
      <span class="clean-brand-mark">JN</span>
      <span>{site.shortName}</span>
    </a>

    <div class="clean-nav-links">
      <a href={base + "#projects"}>Projets</a>
      <a href={base + "#skills"}>Compétences</a>
      <a href={base + "#trajectory"}>Parcours</a>
      <a href={base + "roadmap/"}>Roadmap</a>
    </div>

    <a class="clean-linkedin" href={site.social[1].href} target="_blank" rel="noopener noreferrer">
      LinkedIn ↗
    </a>

    <details class="clean-mobile-menu">
      <summary>Menu</summary>
      <div>
        <a href={base + "#projects"}>Projets</a>
        <a href={base + "#skills"}>Compétences</a>
        <a href={base + "#trajectory"}>Parcours</a>
        <a href={base + "roadmap/"}>Roadmap</a>
        <a href={site.social[1].href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
    </details>
  </nav>
</header>
