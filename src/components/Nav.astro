---
import { site } from "../config";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const sections = [
 {label:"Projets",href:base+"projects/"},
 {label:"Writeups",href:base+"writeups/"},
 {label:"Labs",href:base+"labs/"},
 {label:"Notes",href:base+"notes/"},
 {label:"Roadmap",href:base+"roadmap/"}
];
---
<header class="topbar">
  <nav class="container topbar-inner" aria-label="Navigation principale">
    <a class="wordmark" href={base} aria-label="Joseph NAKORE — Accueil">
      <span class="wordmark-symbol" aria-hidden="true">N<span>✳</span></span>
      <span class="wordmark-name">NAKORE<span class="wordmark-sub">/ SECURITY ENGINEERING</span></span>
    </a>
    <div class="nav-items">
      {sections.map(item=><a href={item.href}>{item.label}</a>)}
    </div>
    <a class="header-cta" href={base+"#contact"}>Travaillons ensemble <span aria-hidden="true">↗</span></a>
    <details class="mobile-nav">
      <summary aria-label="Ouvrir le menu principal">
        <span class="menu-dashes" aria-hidden="true"><i></i><i></i></span>
        Menu
      </summary>
      <div class="mobile-nav-content">
        {sections.map(item=><a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}
        <a href={site.social[0].href} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href={site.social[1].href} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </details>
  </nav>
</header>
