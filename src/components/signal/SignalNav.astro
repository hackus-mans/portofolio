---
import { site } from "../../config";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const links = [
  { text: "Projets", href: "#projects" },
  { text: "Cyber Lab", href: "#cyber-lab" },
  { text: "Publications", href: "#publications" },
  { text: "Parcours", href: "#journey" }
];
---
<header class="sg-header">
  <nav class="sg-shell sg-nav" aria-label="Navigation principale">
    <a class="sg-brand" href={base} aria-label="Joseph NAKORE, retour à l'accueil">
      <span class="sg-brand-mark" aria-hidden="true">N/</span>
      <span class="sg-brand-name">NAKORE <span>// SIGNAL</span></span>
    </a>
    <div class="sg-nav-links">
      {links.map((link) => <a href={link.href}>{link.text}</a>)}
    </div>
    <a class="sg-nav-cta" href="#contact">Me contacter <span aria-hidden="true">↗</span></a>
    <details class="sg-mobile-menu">
      <summary aria-label="Ouvrir la navigation">
        <span aria-hidden="true" class="sg-menu-lines"><i></i><i></i><i></i></span>
        Menu
      </summary>
      <div class="sg-mobile-panel">
        {links.map((link) => <a href={link.href}>{link.text}</a>)}
        <a href={base + "writeups/"}>Writeups</a>
        <a href={base + "labs/"}>Labs</a>
        <a href={base + "notes/"}>Notes techniques</a>
        <a href={site.social[0].href} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href={site.social[1].href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
    </details>
  </nav>
</header>
