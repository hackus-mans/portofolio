---
import {site} from "../config";
const base=import.meta.env.BASE_URL.endsWith("/")?import.meta.env.BASE_URL:import.meta.env.BASE_URL+"/";
const current=Astro.url.pathname;
const items=[
 {name:"Accueil",href:base},
 {name:"Projets",href:base+"projects/"},
 {name:"CTF",href:base+"ctf/"},
 {name:"Home Lab",href:base+"homelab/"},
 {name:"Writeups",href:base+"writeups/"},
 {name:"Certifications",href:base+"certifications/"},
 {name:"À propos",href:base+"about/"},
 {name:"Contact",href:base+"contact/"}
];
const active=(link:string)=>link===base?current===base:current.startsWith(link);
---
<header class="ed-header">
  <nav class="ed-nav ed-container" aria-label="Navigation principale">
    <a class="ed-brand" href={base} aria-label="NAKORE — accueil">
      <span class="ed-brand-glyph">N<span>.</span></span><span class="ed-brand-label">NAKORE</span>
    </a>
    <div class="ed-desktop-links">
      {items.map(item=><a href={item.href} aria-current={active(item.href)?"page":undefined} class:list={["ed-nav-link",{"ed-nav-active":active(item.href)}]}>
        {active(item.href)&&<span aria-hidden="true" class="ed-active-prefix">/</span>}{item.name}
      </a>)}
    </div>
    <details class="ed-mobile-menu">
      <summary aria-label="Ouvrir ou fermer le menu de navigation"><span class="ed-menu-lines" aria-hidden="true"><i></i><i></i><i></i></span><span class="ed-menu-text">Menu</span></summary>
      <div class="ed-mobile-panel">
        {items.map(item=><a href={item.href} aria-current={active(item.href)?"page":undefined} class:list={["ed-mobile-link",{"ed-mobile-active":active(item.href)}]}>
          <span>{item.name}</span><span class="ed-mobile-code">{item.href===base?"~":"~/"+item.href.slice(base.length)}</span>
        </a>)}
        <a class="ed-mobile-external" href={site.social[0].href} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </details>
  </nav>
</header>
