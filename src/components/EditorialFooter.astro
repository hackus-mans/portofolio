---
import {site} from "../config";
const base=import.meta.env.BASE_URL.endsWith("/")?import.meta.env.BASE_URL:import.meta.env.BASE_URL+"/";
---
<footer class="ed-footer">
  <div class="ed-container ed-footer-inner">
    <div>
      <a class="ed-footer-brand" href={base}>NAKORE<span>.</span></a>
      <p>Cybersécurité, systèmes, réseaux et recherche appliquée.<br/>Construire, tester, documenter.</p>
      <small>© {new Date().getFullYear()} Joseph NAKORE · Lomé, Togo</small>
    </div>
    <div class="ed-footer-links" aria-label="Liens utiles">
      <a href={base+"projects/"}>Projets</a>
      <a href={base+"writeups/"}>Writeups</a>
      <a href={base+"journal/"}>Journal</a>
      <a href={site.social[0].href} rel="noopener noreferrer" target="_blank">GitHub ↗</a>
      <a href={site.social[1].href} rel="noopener noreferrer" target="_blank">LinkedIn ↗</a>
    </div>
  </div>
</footer>
