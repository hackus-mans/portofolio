---
import { siteConfig } from "../config";
---
<section id="credentials" class="py-24 sm:py-32">
  <div class="section-shell grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="kicker">04 — Preuves</p>
      <h2 class="mt-4 text-4xl font-bold tracking-[-.04em] text-white sm:text-5xl">Badges & parcours.</h2>
      <p class="mt-5 text-sm leading-7 text-zinc-500">Les éléments en préparation restent explicitement séparés des preuves déjà obtenues.</p>
    </div>
    <div class="lg:col-span-8">
      <div class="grid gap-4 sm:grid-cols-2">
        {siteConfig.credentials.map((item) => {
          const Component = item.link ? "a" : "article";
          const props = item.link ? { href: item.link, target: "_blank", rel: "noopener noreferrer" } : {};
          return (
            <Component {...props} class="group rounded-2xl border border-white/10 bg-white/[.025] p-5 transition hover:border-[var(--accent)]/25">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[var(--accent)]">{item.status}</span>
              <h3 class="mt-3 text-base font-bold leading-6 text-white">{item.title}</h3>
              <p class="mt-2 text-xs text-zinc-500">{item.issuer} · {item.date}</p>
              {item.link && <span class="mt-5 inline-block text-xs text-zinc-400 group-hover:text-[var(--accent)]">Vérifier ↗</span>}
            </Component>
          );
        })}
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {siteConfig.inProgress.map((item) => (
          <article class="rounded-2xl border border-dashed border-amber-300/20 bg-amber-300/[.025] p-5">
            <span class="text-[10px] font-bold uppercase tracking-widest text-amber-300">En préparation</span>
            <h3 class="mt-2 font-bold text-white">{item.title} · {item.issuer}</h3>
            <p class="mt-2 text-xs leading-6 text-zinc-500">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
