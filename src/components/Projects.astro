---
import { siteConfig } from "../config";
const base = import.meta.env.BASE_URL;
---
<section id="projects" class="py-24 sm:py-32">
  <div class="section-shell grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="kicker">02 — Projets</p>
      <h2 class="mt-4 text-4xl font-bold tracking-[-.04em] text-white sm:text-5xl">Des projets qui doivent produire des preuves.</h2>
      <p class="mt-5 text-sm leading-7 text-zinc-500">La structure du template DevPortfolio est conservée, mais les cartes et la hiérarchie ont été refondues pour un portfolio cybersécurité.</p>
    </div>
    <div class="space-y-5 lg:col-span-8">
      {siteConfig.projects.map((project, index) => {
        const href = project.internalLink ? base + project.internalLink : project.link;
        const Component = href ? "a" : "article";
        const linkProps = href ? { href, target: project.link ? "_blank" : undefined, rel: project.link ? "noopener noreferrer" : undefined } : {};
        return (
          <Component {...linkProps} class="group block rounded-2xl border border-white/10 bg-white/[.025] p-6 transition duration-300 hover:-translate-y-1 hover:border-[var(--accent)]/25 hover:bg-white/[.04] sm:p-8">
            <div class="flex items-start justify-between gap-6">
              <div>
                <span class="text-xs font-bold text-[var(--accent)]">0{index + 1} · {project.label}</span>
                <h3 class="mt-3 text-2xl font-bold tracking-[-.03em] text-white sm:text-3xl">{project.name}</h3>
              </div>
              {href && <span class="grid size-10 shrink-0 place-items-center rounded-full border border-white/10 text-[var(--accent)] transition group-hover:bg-[var(--accent)] group-hover:text-[#061009]">↗</span>}
            </div>
            <p class="mt-5 max-w-3xl leading-7 text-zinc-400">{project.description}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {project.skills.map((skill) => <span class="rounded-lg bg-[#111a16] px-3 py-2 text-xs text-zinc-300">{skill}</span>)}
            </div>
            <div class="mt-7 border-t border-white/10 pt-5 text-xs font-bold text-zinc-500">{project.proof}</div>
          </Component>
        );
      })}
    </div>
  </div>
</section>
