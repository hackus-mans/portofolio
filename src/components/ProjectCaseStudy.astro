---
import BaseLayout from "../layouts/BaseLayout.astro";
import {site} from "../config";
import {cases} from "../data/caseStudies";
const {slug}=Astro.props;
const project=site.projects.find(p=>p.slug===slug);
const study=cases[slug];
if(!project||!study)throw new Error("Unknown case study: "+slug);
const rawBase=import.meta.env.BASE_URL;
const base=rawBase.endsWith("/")?rawBase:rawBase+"/";
---
<BaseLayout title={project.name+" — Joseph NAKORE"} description={study.overview}>
  <main id="main-content">
    <header class="page-hero">
      <div class="container">
        <a class="back-link" href={base+"projects/"}>← Tous les projets</a>
        <p class="label-dark">{project.index} / CASE STUDY / {project.type}</p>
        <h1>{project.name}<span style="color:var(--volt)">.</span></h1>
        <p class="lead">{study.overview}</p>
        <div class="hero-foot"><span>{project.status}</span><span>{project.outcome}</span><span>DOCUMENTED ENGINEERING</span></div>
      </div>
    </header>
    <div class="container case-grid">
      <div class="case-body">
        <section class="case-section" id="problem"><p class="mono-kicker">01 / THE QUESTION</p><h2>{study.question}</h2><p>{study.context}</p></section>
        <section class="case-section" id="method"><p class="mono-kicker">02 / APPROACH</p><h2>Une démarche structurée, pas un assemblage d'outils.</h2><p>{study.method}</p></section>
        <section class="case-section" id="architecture"><p class="mono-kicker">03 / SYSTEM ARCHITECTURE</p><h2>Du composant à sa responsabilité.</h2><div class="case-steps">{study.architecture.map(step=><div class="case-step"><span>{step.name.slice(0,2)}</span><div><strong>{step.name.slice(5)}</strong><p>{step.detail}</p></div></div>)}</div></section>
        <section class="case-section" id="engineering"><p class="mono-kicker">04 / ENGINEERING DECISIONS</p><h2>Les choix qui font la différence.</h2><ul class="case-list">{study.engineering.map(item=><li>{item}</li>)}</ul></section>
        <section class="case-section" id="validation"><p class="mono-kicker">05 / VALIDATION STRATEGY</p><h2>Ce qu'il faut vérifier.</h2><ul class="case-list">{study.validation.map(item=><li>{item}</li>)}</ul></section>
        <section class="case-section" id="results"><p class="mono-kicker">06 / OUTCOMES & EVIDENCE</p><h2>Résultat et niveau de preuve.</h2><div class="case-evidence"><strong>ÉTAT ACTUEL / NE PAS CONFONDRE AVEC UNE VALIDATION INDUSTRIELLE</strong><p>{study.result}</p></div></section>
        <section class="case-section" id="limits"><p class="mono-kicker">07 / LIMITATIONS & NEXT</p><h2>Ce que le projet ne prouve pas encore.</h2><p>{study.caveat}</p><h3 class="heading-m" style="margin-top:35px">Prochaines étapes</h3><ul class="case-list">{study.next.map(item=><li>{item}</li>)}</ul></section>
        {study.external&&<a class="button" href={study.external.url} target="_blank" rel="noopener noreferrer">{study.external.title}<span class="arrow" aria-hidden="true">↗</span></a>}
        <div class="case-pilltags">{project.tags.map(t=><span>{t}</span>)}</div>
      </div>
      <aside class="case-aside">
        <h3>Project brief</h3>
        <dl>
          <div><dt>Projet</dt><dd>{project.name}</dd></div>
          <div><dt>Domaine</dt><dd>{project.type}</dd></div>
          <div><dt>Statut</dt><dd>{project.status}</dd></div>
          <div><dt>Repère</dt><dd>{project.outcome}</dd></div>
        </dl>
        <a class="button" href={base+"projects/"}>Tous les projets<span class="arrow" aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </main>
</BaseLayout>
