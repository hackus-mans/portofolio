---
import { siteConfig } from "../config";
---
<section class="border-y border-white/10 bg-[#080d0b]/75 py-24 sm:py-32">
  <div class="section-shell grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="kicker">05 — Formation</p>
      <h2 class="mt-4 text-4xl font-bold tracking-[-.04em] text-white sm:text-5xl">Formation académique.</h2>
    </div>
    <div class="lg:col-span-8">
      {siteConfig.education.map((edu) => (
        <article class="rounded-2xl border border-white/10 bg-white/[.025] p-6 sm:p-8">
          <div class="flex flex-col justify-between gap-3 sm:flex-row">
            <div>
              <h3 class="text-xl font-bold text-white">{edu.degree}</h3>
              <p class="mt-1 text-sm text-[var(--accent)]">{edu.school}</p>
            </div>
            <span class="text-xs text-zinc-500">{edu.dateRange}</span>
          </div>
          <ul class="mt-6 space-y-3">
            {edu.achievements.map((achievement) => (
              <li class="flex gap-3 text-sm leading-6 text-zinc-400"><span class="text-[var(--accent)]">→</span><span>{achievement}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
